// @description A set of extension methods for a novel implementation of a Approximate Nearest Neighbors (ANN) algorithm in Lorentzian space.


// ==========================
// ==== Helper Functions ====
// ==========================

// @function Returns the smoothed hyperbolic tangent of the input series.
// @param src <series float> The input series (i.e., the first-order derivative for price).
// @param quadraticMeanLength <int>  The length of the quadratic mean (RMS).
// @returns	nDeriv <series float> The normalized derivative of the input series.
normalizeDeriv(series float src, int quadraticMeanLength) =>
    // Calculate the derivative of the input series.
    float deriv = src - src[2]
    // Calculate the quadratic mean of the derivative.
    quadraticMean = math.sqrt(nz(math.sum(math.pow(deriv, 2), quadraticMeanLength) / quadraticMeanLength))
    // Return the normalized derivative.
    nDeriv = deriv / quadraticMean
    nDeriv

// @function Rescales a source value with an unbounded range to a target range.
// @param src <series float> The input series
// @param min <float> The minimum value of the unbounded range
// @param max <float> The maximum value of the unbounded range
// @returns <series float> The normalized series
normalize(series float src, float min, float max) => 
    var _historicMin =  10e10
    var _historicMax = -10e10
    _historicMin := math.min(nz(src, _historicMin), _historicMin)
    _historicMax := math.max(nz(src, _historicMax), _historicMax)
    min + (max - min) * (src - _historicMin) / math.max(_historicMax - _historicMin, 10e-10)

// @function Rescales a source value with a bounded range to anther bounded range
// @param src <series float> The input series
// @param oldMin <float> The minimum value of the range to rescale from
// @param oldMax <float> The maximum value of the range to rescale from
// @param newMin <float> The minimum value of the range to rescale to
// @param newMax <float> The maximum value of the range to rescale to 
// @returns <series float> The rescaled series
rescale(series float src, float oldMin, float oldMax, float newMin, float newMax) =>
    newMin + (newMax - newMin) * (src - oldMin) / math.max(oldMax - oldMin, 10e-10)

// ================
// ==== Colors ====
// ================

// @function Creates an array of colors with varying shades of the input color
// @param color <color> The color to create shades of
// @returns <array color> An array of colors with varying shades of the input color
getColorShades(color color) =>
    float r = color.r(color)
    float g = color.g(color)
    float b = color.b(color)
    int[] intensity = array.new_int(0)
    array.push(intensity, 25)
    array.push(intensity, 50)
    array.push(intensity, 75)
    array.push(intensity, 100)
    color[] shades = array.new_color(0)
    for i = 0 to array.size(intensity) - 1
        float shadeR = r * array.get(intensity, i) / 100
        float shadeG = g * array.get(intensity, i) / 100
        float shadeB = b * array.get(intensity, i) / 100
        color shadeColor = color.rgb(shadeR, shadeG, shadeB)
        array.push(shades, shadeColor)
    shades

// @function Determines the color shade based on prediction percentile
// @param prediction <float> Value of the prediction
// @param neighborsCount <int> The number of neighbors used in a nearest neighbors classification
// @param shadesArr <array color> An array of colors with varying shades of the input color
// @returns shade <color> Color shade based on prediction percentile
getPredictionColor(float prediction, int neighborsCount, array<color> shadesArr) =>
    float percentile = prediction / neighborsCount * 100
    color shade = na
    switch
        percentile >= 75 => shade := array.get(shadesArr, 3) // most intense shade
        percentile >= 50 => shade := array.get(shadesArr, 2)
        percentile >= 25 => shade := array.get(shadesArr, 1)
        percentile >= 0  => shade := array.get(shadesArr, 0) // least intense shade
    shade

// @function Assigns varying shades of the color green based on the KNN classification
// @param prediction Value (int|float) of the prediction 
// @returns color <color>
color_green(float prediction) =>
	switch
		prediction >= 9 => #15FF00
		prediction >= 8 => #15FF00E5
		prediction >= 7 => #09FF00CC 
		prediction >= 6 => #09FF00B2
		prediction >= 5 => #09FF0099 
		prediction >= 4 => #15FF007F
		prediction >= 3 => #00FF0066
		prediction >= 2 => #09FF004C 
		prediction >= 1 => #09FF0033 
		=> #15FF0019

// @function Assigns varying shades of the color red based on the KNN classification
// @param prediction Value of the prediction
// @returns color
color_red(float prediction) =>
	switch
		prediction >= 9 => #CC3311
		prediction >= 8 => #CC3311E5
		prediction >= 7 => #B23111CC
		prediction >= 6 => #B23111B2
		prediction >= 5 => #B2311199
		prediction >= 4 => #CC33117F
		prediction >= 3 => #CC331166
		prediction >= 2 => #CC33114C
		prediction >= 1 => #CC331133
		=> #CC331119

// @function Returns the the hyperbolic tangent of the input series. The sigmoid-like hyperbolic tangent function is used to compress the input to a value between -1 and 1.
// @param src <series float> The input series (i.e., the normalized derivative).
// @returns	tanh <series float> The hyperbolic tangent of the input series.
tanh(series float src) =>
    tanh = -1 + 2/(1 + math.exp(-2*src))
    tanh

// @function Returns the smoothed hyperbolic tangent of the input series.
//@param src <series float> The input series (i.e., the hyperbolic tangent).
//@param lookback <int> The lookback window for the smoothing.
//@returns filter <series float> The smoothed hyperbolic tangent of the input series.
dualPoleFilter(series float src, int lookback) =>
    float omega = -99 * math.pi / (70 * lookback)
    float alpha = math.exp(omega)
    float beta = -math.pow(alpha, 2)
    float gamma = math.cos(omega) * 2 * alpha
    float delta = 1 - gamma - beta
    float slidingAvg = 0.5 * (src + nz(src[1], src))
    float filter = na
    filter := (delta*slidingAvg) + gamma*nz(filter[1]) + beta*nz(filter[2])
	filter

// @function Returns the tanh transform of the input series.
// @param src <series float> The input series (i.e., the result of the tanh calculation).
// @param lookback <int> The lookback window for the smoothing.
// @returns signal <series float> The smoothed hyperbolic tangent transform of the input series.
tanhTransform(series float src, int smoothingFrequency, int quadraticMeanLength) =>   
    signal = dualPoleFilter(tanh(normalizeDeriv(src, quadraticMeanLength)), smoothingFrequency)
    signal

// @function Returns the normalized RSI ideal for use in ML algorithms.
// @param src <series float> The input series (i.e., the result of the RSI calculation).
// @param n1 <int> The length of the RSI.
// @param n2 <int> The smoothing length of the RSI.
// @returns signal <series float> The normalized RSI.
n_rsi(series float src, simple int n1, simple int n2) =>
    rescale(ta.ema(ta.rsi(src, n1), n2), 0, 100, 0, 1)

// @function Returns the normalized CCI ideal for use in ML algorithms.
// @param src <series float> The input series (i.e., the result of the CCI calculation).
// @param n1 <int> The length of the CCI.
// @param n2 <int> The smoothing length of the CCI.
// @returns signal <series float> The normalized CCI.
n_cci(series float src, simple int n1, simple int n2) =>
    normalize(ta.ema(ta.cci(src, n1), n2), 0, 1)

// @function Returns the normalized WaveTrend Classic series ideal for use in ML algorithms.
// @param src <series float> The input series (i.e., the result of the WaveTrend Classic calculation).
// @param paramA <int> The first smoothing length for WaveTrend Classic.
// @param paramB <int> The second smoothing length for the WaveTrend Classic.
// @param transformLength <int> The length of the transform.
// @returns signal <series float> The normalized WaveTrend Classic series.
n_wt(series float src, simple int n1=10, simple int n2=11) =>
    ema1 = ta.ema(src, n1)
    ema2 = ta.ema(math.abs(src - ema1), n1)
    ci = (src - ema1) / (0.015 * ema2)
    wt1 = ta.ema(ci, n2) // tci
    wt2 = ta.sma(wt1, 4)
    normalize(wt1 - wt2, 0, 1)

// @function Returns the normalized ADX ideal for use in ML algorithms.
// @param highSrc <series float> The input series for the high price.
// @param lowSrc <series float> The input series for the low price.
// @param closeSrc <series float> The input series for the close price.
// @param n1 <int> The length of the ADX.
n_adx(series float highSrc, series float lowSrc, series float closeSrc, simple int n1) =>
    length = n1
    th = 20
    tr = math.max(math.max(highSrc - lowSrc, math.abs(highSrc - nz(closeSrc[1]))), math.abs(lowSrc - nz(closeSrc[1])))
    directionalMovementPlus = highSrc - nz(highSrc[1]) > nz(lowSrc[1]) - lowSrc ? math.max(highSrc - nz(highSrc[1]), 0) : 0
    negMovement = nz(lowSrc[1]) - lowSrc > highSrc - nz(highSrc[1]) ? math.max(nz(lowSrc[1]) - lowSrc, 0) : 0
    trSmooth = 0.0
    trSmooth := nz(trSmooth[1]) - nz(trSmooth[1]) / length + tr
    smoothDirectionalMovementPlus = 0.0
    smoothDirectionalMovementPlus := nz(smoothDirectionalMovementPlus[1]) - nz(smoothDirectionalMovementPlus[1]) / length + directionalMovementPlus
    smoothnegMovement = 0.0
    smoothnegMovement := nz(smoothnegMovement[1]) - nz(smoothnegMovement[1]) / length + negMovement
    diPositive = smoothDirectionalMovementPlus / trSmooth * 100
    diNegative = smoothnegMovement / trSmooth * 100
    dx = math.abs(diPositive - diNegative) / (diPositive + diNegative) * 100 
    adx = ta.rma(dx, length)
    rescale(adx, 0, 100, 0, 1)


// =================
// ==== Filters ====
// =================

// # @regime_filter
// # @param src <series float> The source series.
// # @param threshold <float> The threshold.
// # @param useRegimeFilter <bool> Whether to use the regime filter.
// # @returns <bool> Boolean indicating whether or not to let the signal pass through the filter.
regime_filter(series float src=ohlc4, float threshold, bool useRegimeFilter) =>
    // Calculate the slope of the curve.
    value1 = 0.0
    value2 = 0.0
    klmf = 0.0
    value1 := 0.2 * (src - src[1]) + 0.8 * nz(value1[1])
    value2 := 0.1 * (high - low) + 0.8 * nz(value2[1])
    omega = math.abs(value1 / value2)
    alpha = (-math.pow(omega,2) + math.sqrt(math.pow(omega, 4) + 16 * math.pow(omega,2))) / 8 
    klmf := alpha * src + (1 - alpha) * nz(klmf[1])
    absCurveSlope = math.abs(klmf - klmf[1])
    exponentialAverageAbsCurveSlope = 1.0 * ta.ema(absCurveSlope, 200)
    normalized_slope_decline = (absCurveSlope - exponentialAverageAbsCurveSlope) / exponentialAverageAbsCurveSlope
    // Calculate the slope of the curve.
    useRegimeFilter ? normalized_slope_decline >= threshold : true

// @function filter_adx
// @param src <series float> The source series.
// @param length <int> The length of the ADX.
// @param adxThreshold <int> The ADX threshold.
// @param useAdxFilter <bool> Whether to use the ADX filter.
// @returns <series float> The ADX.
filter_adx(series float src=close, simple int length=14, int adxThreshold, bool useAdxFilter) =>
    tr = math.max(math.max(high - low, math.abs(high - nz(src[1]))), math.abs(low - nz(src[1])))
    directionalMovementPlus = high - nz(high[1]) > nz(low[1]) - low ? math.max(high - nz(high[1]), 0) : 0
    negMovement = nz(low[1]) - low > high - nz(high[1]) ? math.max(nz(low[1]) - low, 0) : 0
    trSmooth = 0.0
    trSmooth := nz(trSmooth[1]) - nz(trSmooth[1]) / length + tr
    smoothDirectionalMovementPlus = 0.0
    smoothDirectionalMovementPlus := nz(smoothDirectionalMovementPlus[1]) - nz(smoothDirectionalMovementPlus[1]) / length + directionalMovementPlus
    smoothnegMovement = 0.0
    smoothnegMovement := nz(smoothnegMovement[1]) - nz(smoothnegMovement[1]) / length + negMovement
    diPositive = smoothDirectionalMovementPlus / trSmooth * 100
    diNegative = smoothnegMovement / trSmooth * 100
    dx = math.abs(diPositive - diNegative) / (diPositive + diNegative) * 100
    adx = ta.rma(dx, length)
    useAdxFilter ? adx > adxThreshold : true

// @function filter_volatility
// @param minLength <int> The minimum length of the ATR.
// @param maxLength <int> The maximum length of the ATR.
// @param useVolatilityFilter <bool> Whether to use the volatility filter.
// @returns <bool> Boolean indicating whether or not to let the signal pass through the filter.
filter_volatility(simple int minLength=1, simple int maxLength=10, bool useVolatilityFilter) =>
    recentAtr = ta.atr(minLength)
    historicalAtr = ta.atr(maxLength)
    useVolatilityFilter ? recentAtr > historicalAtr : true

// =====================
// ==== Backtesting ====
// =====================

// @function Performs a basic backtest using the specified parameters and conditions.
// @param high <series float> The input series for the high price.
// @param low <series float> The input series for the low price.
// @param open <series float> The input series for the open price.
// @param startLongTrade <series bool> The series of conditions that indicate the start of a long trade.
// @param endLongTrade <series bool> The series of conditions that indicate the end of a long trade.
// @param startShortTrade <series bool> The series of conditions that indicate the start of a short trade.
// @param endShortTrade <series bool> The series of conditions that indicate the end of a short trade.
// @param isEarlySignalFlip <bool> Whether or not the signal flip is early.
// @param maxBarsBackIndex <int> The maximum number of bars to go back in the backtest.
// @param thisBarIndex <int> The current bar index.
// @param src <series float> The source series.
// @param useWorstCase <bool> Whether to use the worst case scenario for the backtest.
// @returns <tuple strings> A tuple containing backtest values
backtest(series float high, series float low, series float open, series bool startLongTrade, series bool endLongTrade, series bool startShortTrade, series bool endShortTrade, series bool isEarlySignalFlip, int maxBarsBackIndex, int thisBarIndex, series float src, bool useWorstCase) =>
    marketPrice = useWorstCase ? src : (high + low + open + open)/4
    var float start_long_trade = marketPrice
    var float start_short_trade = marketPrice
    var float total_short_profit = 0.
    var float total_long_profit = 0.
    var int wins = 0
    var int losses = 0
    var int trade_count = 0
    var int early_signal_flip_count = 0
    var bool tookProfit = false
    lot_size = 1
    if thisBarIndex > maxBarsBackIndex
        trade_count := 0
        wins := 0
        losses := 0
        early_signal_flip_count := 0
        if startLongTrade
            start_short_trade := 0.
            early_signal_flip_count := isEarlySignalFlip ? 1 : 0
            start_long_trade := marketPrice
            trade_count := 1
        if endLongTrade
            delta = marketPrice - start_long_trade
            wins := delta > 0 ? 1 : 0
            losses := delta < 0 ? 1 : 0
            total_long_profit := delta * lot_size
        if startShortTrade
            start_long_trade := 0.
            start_short_trade := marketPrice
            trade_count := 1
        if endShortTrade
            early_signal_flip_count := isEarlySignalFlip ? 1 : 0
            delta = start_short_trade - marketPrice
            wins := delta > 0 ? 1 : 0
            losses := delta < 0 ? 1 : 0
            total_short_profit := delta * lot_size
    tradeStatsHeader = '📈 Trade Stats'
    longProfit = ta.cum(total_long_profit)
    shortProfit = ta.cum(total_short_profit)
    longShortProfit = longProfit + shortProfit
    totalEarlySignalFlips = ta.cum(early_signal_flip_count)
    totalWins = ta.cum(wins)
    totalLosses = ta.cum(losses)
    totalTrades = ta.cum(wins+losses)
    winLossRatio = totalWins / totalTrades
    winRate = totalWins / (totalWins + totalLosses)
    [totalWins, totalLosses, totalEarlySignalFlips, totalTrades, tradeStatsHeader, winLossRatio, winRate]

// @function init_table()
// @returns tbl <series table> The backtest results.
init_table() =>    
    c_transparent = color.new(color.black, 100)
    table.new(position.top_right, columns=2, rows=7, frame_color=c_transparent, frame_width=1, border_width=1, border_color=c_transparent)

// @function update_table(tbl, tradeStats)
// @param tbl <series table> The backtest results table.
// @param tradeStatsHeader <string> The trade stats header.
// @param totalTrades <float> The total number of trades.
// @param totalWins <float> The total number of wins.
// @param totalLosses <float> The total number of losses.
// @param winLossRatio <float> The win loss ratio.
// @param winrate <float> The winrate.
// @param earlySignalFlips <float> The total number of early signal flips.
// @returns <void> Updated backtest results table.
update_table(series table tbl, string tradeStatsHeader, float totalTrades, float totalWins, float totalLosses, float winLossRatio, float winrate, float earlySignalFlips) =>
    c_transparent = color.new(color.black, 100)
    table.cell(tbl, 0, 0, tradeStatsHeader, text_halign=text.align_center, text_color=color.gray, text_size=size.normal)
    table.cell(tbl, 0, 1, 'Winrate', text_halign=text.align_center, bgcolor=c_transparent, text_color=color.gray, text_size=size.normal)
    table.cell(tbl, 1, 1, str.tostring(winrate, '#.#') + '%', text_halign=text.align_center, bgcolor=c_transparent, text_color=color.gray, text_size=size.normal)
    table.cell(tbl, 0, 2, 'Trades', text_halign=text.align_center, bgcolor=c_transparent, text_color=color.gray, text_size=size.normal)
    table.cell(tbl, 1, 2, str.tostring(totalTrades, '#') + ' (' + str.tostring(totalWins, '#') + '|' + str.tostring(totalLosses, '#') + ')', text_halign=text.align_center, bgcolor=c_transparent, text_color=color.gray, text_size=size.normal)
    table.cell(tbl, 0, 5, 'WL Ratio', text_halign=text.align_center, bgcolor=c_transparent, text_color=color.gray, text_size=size.normal)
    table.cell(tbl, 1, 5, str.tostring(winLossRatio, '#.#'), text_halign=text.align_center, bgcolor=c_transparent, text_color=color.gray, text_size=size.normal)
    table.cell(tbl, 0, 6, 'Early Signal Flip Count', text_halign=text.align_center, bgcolor=c_transparent, text_color=color.gray, text_size=size.normal)
    table.cell(tbl, 1, 6, str.tostring(earlySignalFlips, '#'), text_halign=text.align_center, bgcolor=c_transparent, text_color=color.gray, text_size=size.normal)
// ===== END inlined jdehorty/MLExtensions =====


// ===== BEGIN inlined jdehorty/KernelFunctions as kernels =====
// This source code is subject to the terms of the Mozilla Public License 2.0 at https://mozilla.org/MPL/2.0/
// © jdehorty
// @version=5

// @description This library provides non-repainting kernel functions for Nadaraya-Watson estimator implementations. This allows for easy substition/comparison of different kernel functions for one another in indicators. Furthermore, kernels can easily be combined with other kernels to create newer, more customized kernels.

// @function Rational Quadratic Kernel - An infinite sum of Gaussian Kernels of different length scales.
// @param _src <float series> The source series.
// @param _lookback <simple int> The number of bars used for the estimation. This is a sliding value that represents the most recent historical bars.
// @param _relativeWeight <simple float> Relative weighting of time frames. Smaller values resut in a more stretched out curve and larger values will result in a more wiggly curve. As this value approaches zero, the longer time frames will exert more influence on the estimation. As this value approaches infinity, the behavior of the Rational Quadratic Kernel will become identical to the Gaussian kernel.
// @param _startAtBar <simple int> Bar index on which to start regression. The first bars of a chart are often highly volatile, and omission of these initial bars often leads to a better overall fit.
// @returns yhat <float series> The estimated values according to the Rational Quadratic Kernel.
rationalQuadratic(series float _src, simple int _lookback, simple float _relativeWeight, simple int startAtBar) =>
	float _currentWeight = 0.
	float _cumulativeWeight = 0.
	_size = array.size(array.from(_src))
    for i = 0 to _size + startAtBar
        y = _src[i]
        w = math.pow(1 + (math.pow(i, 2) / ((math.pow(_lookback, 2) * 2 * _relativeWeight))), -_relativeWeight)
        _currentWeight += y*w
        _cumulativeWeight += w
    yhat = _currentWeight / _cumulativeWeight
    yhat

// @function Gaussian Kernel - A weighted average of the source series. The weights are determined by the Radial Basis Function (RBF).
// @param _src <float series> The source series.
// @param _lookback <simple int> The number of bars used for the estimation. This is a sliding value that represents the most recent historical bars.
// @param _startAtBar <simple int> Bar index on which to start regression. The first bars of a chart are often highly volatile, and omission of these initial bars often leads to a better overall fit.
// @returns yhat <float series> The estimated values according to the Gaussian Kernel.
gaussian(series float _src, simple int _lookback, simple int startAtBar) =>
    float _currentWeight = 0.
    float _cumulativeWeight = 0.
    _size = array.size(array.from(_src))
    for i = 0 to _size + startAtBar
        y = _src[i] 
        w = math.exp(-math.pow(i, 2) / (2 * math.pow(_lookback, 2)))
        _currentWeight += y*w
        _cumulativeWeight += w
    yhat = _currentWeight / _cumulativeWeight
    yhat

// @function Periodic Kernel - The periodic kernel (derived by David Mackay) allows one to model functions which repeat themselves exactly.
// @param _src <float series> The source series.
// @param _lookback <simple int> The number of bars used for the estimation. This is a sliding value that represents the most recent historical bars.
// @param _period <simple int> The distance between repititions of the function.
// @param _startAtBar <simple int> Bar index on which to start regression. The first bars of a chart are often highly volatile, and omission of these initial bars often leads to a better overall fit.
// @returns yhat <float series> The estimated values according to the Periodic Kernel.
periodic(series float _src, simple int _lookback, simple int _period, simple int startAtBar) =>
    float _currentWeight = 0.
    float _cumulativeWeight = 0.
    _size = array.size(array.from(_src))
    for i = 0 to _size + startAtBar
        y = _src[i]
        w = math.exp(-2*math.pow(math.sin(math.pi * i / _period), 2) / math.pow(_lookback, 2))
        _currentWeight += y*w
        _cumulativeWeight += w
    yhat = _currentWeight / _cumulativeWeight
    yhat

// @function Locally Periodic Kernel - The locally periodic kernel is a periodic function that slowly varies with time. It is the product of the Periodic Kernel and the Gaussian Kernel.
// @param _src <float series> The source series.
// @param _lookback <simple int> The number of bars used for the estimation. This is a sliding value that represents the most recent historical bars.
// @param _period <simple int> The distance between repititions of the function.
// @param _startAtBar <simple int> Bar index on which to start regression. The first bars of a chart are often highly volatile, and omission of these initial bars often leads to a better overall fit.
// @returns yhat <float series> The estimated values according to the Locally Periodic Kernel.
locallyPeriodic(series float _src, simple int _lookback, simple int _period, simple int startAtBar) =>
    float _currentWeight = 0.
    float _cumulativeWeight = 0.
    _size = array.size(array.from(_src))
    for i = 0 to _size + startAtBar
        y = _src[i]
        w = math.exp(-2*math.pow(math.sin(math.pi * i / _period), 2) / math.pow(_lookback, 2)) * math.exp(-math.pow(i, 2) / (2 * math.pow(_lookback, 2)))
        _currentWeight += y*w
        _cumulativeWeight += w
    yhat = _currentWeight / _cumulativeWeight
    yhat

// ===== END inlined jdehorty/KernelFunctions =====


//@version=5
indicator('My Script', 'My Script', overlay=true, format=format.price, precision=4, max_labels_count=500)

Periods = 10
srcx = hlc3
Multiplier1 = 0.8
Multiplier2 = 1.6
changeATR = true
showsignals = true
highlighting = true
atr2 = ta.sma(ta.atr(1), Periods)
atr = changeATR ? ta.atr(Periods) : atr2
// Set up the initial direction buy/sell signals
up = srcx - Multiplier1 * atr
up1 = nz(up[1], up)
up := close[1] > up1 ? math.max(up, up1) : up
dn = srcx + Multiplier1 * atr
dn1 = nz(dn[1], dn)
dn := close[1] < dn1 ? math.min(dn, dn1) : dn
trend = 1
trend := nz(trend[1], trend)
trend := trend == -1 and close > dn1 ? 1 : trend == 1 and close < up1 ? -1 : trend
upPlot = plot(trend == 1 ? up : na, title='Up Trend', style=plot.style_linebr, linewidth=1, color=color.new(color.green, 0))
buySignal = trend == 1 and trend[1] == -1
plotshape(buySignal ? up : na, title='UpTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(color.green, 0))
plotshape(buySignal and showsignals ? up : na, title='Buy', text='Buy', location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(color.green, 0), textcolor=color.new(color.white, 0))
dnPlot = plot(trend == 1 ? na : dn, title='Down Trend', style=plot.style_linebr, linewidth=1, color=color.new(color.red, 0))
sellSignal = trend == -1 and trend[1] == 1
plotshape(sellSignal ? dn : na, title='DownTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(color.red, 0))
plotshape(sellSignal and showsignals ? dn : na, title='Sell', text='Sell', location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(color.red, 0), textcolor=color.new(color.white, 0))

// Set up the confirmation buy/sell signals
upx = srcx - Multiplier2 * atr
upx1 = nz(upx[1], upx)
upx := close[1] > upx1 ? math.max(upx, upx1) : upx
dnx = srcx + Multiplier2 * atr
dnx1 = nz(dnx[1], dnx)
dnx := close[1] < dnx1 ? math.min(dnx, dnx1) : dnx
trendx = 1
trendx := nz(trendx[1], trendx)
trendx := trendx == -1 and close > dnx1 ? 1 : trendx == 1 and close < upx1 ? -1 : trendx
upxPlot = plot(trendx == 1 ? upx : na, title='Up Trend', style=plot.style_linebr, linewidth=2, color=color.rgb(0, 255, 0))
buySignalx = trendx == 1 and trendx[1] == -1
plotshape(buySignalx ? upx : na, title='UpTrend Confirmed', location=location.absolute, style=shape.circle, size=size.tiny, color=color.rgb(0, 255, 0, 0))
plotshape(buySignalx and showsignals ? upx : na, title='Buy', text='Buy', location=location.absolute, style=shape.labelup, size=size.tiny, color=color.rgb(0, 255, 0,0), textcolor=color.new(color.black, 0))
dnxPlot = plot(trendx == 1 ? na : dnx, title='Down Trend', style=plot.style_linebr, linewidth=2, color=color.rgb(255, 0, 0))
sellSignalx = trendx == -1 and trendx[1] == 1
plotshape(sellSignalx ? dnx : na, title='DownTrend Confirmed', location=location.absolute, style=shape.circle, size=size.tiny, color=color.rgb(255, 0, 0, 0))
plotshape(sellSignalx and showsignals ? dnx : na, title='Sell', text='Sell', location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.rgb(255, 0, 0,0), textcolor=color.new(color.white, 0))

per=input(21, title='calculate for last ## bars')
hl=ta.highest(high,per) //High Line (Border)
ll=ta.lowest(low,per)   //Low Line  (Border)
dist=hl-ll          //range of the channel    
hf=hl-dist*0.236    //Highest Fibonacci line
cfh=hl-dist*0.382    //Center High Fibonacci line
cfl=hl-dist*0.618    //Center Low Fibonacci line
lf=hl-dist*0.764     //Lowest Fibonacci line
fill(plot(hl, title="high border"), plot(hf), color = color.new(color.lime,90)) //up trend zone
fill(plot(ll, title="low border"), plot(lf), color=color.new(color.red,90))   //down trend zone

shortest = ta.ema(close, 20)
short = ta.ema(close, 50)
longer = ta.ema(close, 100)
longest = ta.ema(close, 200)

len2 = 50
src2 = input(close, title="Source")
out2 = ta.sma(src2, len2)
len1 = 200
src1 = input(close, title="Source")
out1 = ta.sma(src1, len1)


type Settings
    float source
    int neighborsCount
    int maxBarsBack
    int featureCount
    int colorCompression
    bool showExits
    bool useDynamicExits

type Label
    int long
    int short
    int neutral

type FeatureArrays
    array<float> f1
    array<float> f2
    array<float> f3
    array<float> f4
    array<float> f5

type FeatureSeries
    float f1
    float f2
    float f3
    float f4
    float f5

type MLModel
    int firstBarIndex
    array<int> trainingLabels
    int loopSize
    float lastDistance
    array<float> distancesArray
    array<int> predictionsArray
    int prediction

type FilterSettings 
    bool useVolatilityFilter
    bool useRegimeFilter
    bool useAdxFilter
    float regimeThreshold
    int adxThreshold

type Filter
    bool volatility
    bool regime
    bool adx 

// ==========================
// ==== Helper Functions ====
// ==========================

series_from(feature_string, _close, _high, _low, _hlc3, f_paramA, f_paramB) =>
    switch feature_string
        "RSI" => n_rsi(_close, f_paramA, f_paramB)
        "WT" => n_wt(_hlc3, f_paramA, f_paramB)
        "CCI" => n_cci(_close, f_paramA, f_paramB)
        "ADX" => n_adx(_high, _low, _close, f_paramA)

get_lorentzian_distance(int i, int featureCount, FeatureSeries featureSeries, FeatureArrays featureArrays) =>
    d1 = math.log(1 + math.abs(featureSeries.f1 - array.get(featureArrays.f1, i)))
    d2 = math.log(1 + math.abs(featureSeries.f2 - array.get(featureArrays.f2, i)))
    d3 = math.log(1 + math.abs(featureSeries.f3 - array.get(featureArrays.f3, i)))
    d4 = math.log(1 + math.abs(featureSeries.f4 - array.get(featureArrays.f4, i)))
    d5 = math.log(1 + math.abs(featureSeries.f5 - array.get(featureArrays.f5, i)))
    featureCount == 5 ? d1 + d2 + d3 + d4 + d5 :
     featureCount == 4 ? d1 + d2 + d3 + d4 :
     featureCount == 3 ? d1 + d2 + d3 :
     d1 + d2

// ================  
// ==== Inputs ==== 
// ================ 

// Settings Object: General User-Defined Inputs
Settings settings = Settings.new(input.source(title='Source', defval=close, group="General Settings", tooltip="Source of the input data"), input.int(title='Neighbors Count', defval=8, group="General Settings", minval=1, maxval=100, step=1, tooltip="Number of neighbors to consider"), input.int(title="Max Bars Back", defval=2000, group="General Settings"), input.int(title="Feature Count", defval=5, group="Feature Engineering", minval=2, maxval=5, tooltip="Number of features to use for ML predictions."), input.int(title="Color Compression", defval=1, group="General Settings", minval=1, maxval=10, tooltip="Compression factor for adjusting the intensity of the color scale."), input.bool(title="Show Default Exits", defval=false, group="General Settings", tooltip="Default exits occur exactly 4 bars after an entry signal. This corresponds to the predefined length of a trade during the model's training process.", inline="exits"), input.bool(title="Use Dynamic Exits", defval=false, group="General Settings", tooltip="Dynamic exits attempt to let profits ride by dynamically adjusting the exit threshold based on kernel regression logic.", inline="exits"))
   
// Trade Stats Settings
// Note: The trade stats section is NOT intended to be used as a replacement for proper backtesting. It is intended to be used for calibration purposes only
showTradeStats = input.bool(false, title="Show Performance Panel", group="Performance")
useWorstCase = input.bool(false, title="Use Worst-Case Fills", group="Performance")

// Settings object for user-defined settings
FilterSettings filterSettings = FilterSettings.new(input.bool(title="Use Volatility Filter", defval=false, tooltip="Whether to use the volatility filter.", group="Filters"), input.bool(title="Use Regime Filter", defval=false, group="Filters", inline="regime"), input.bool(title="Use ADX Filter", defval=true, group="Filters", inline="adx"), input.float(title="Threshold", defval=-0.1, minval=-10, maxval=10, step=0.1, tooltip="Whether to use the trend detection filter. Threshold for detecting Trending/Ranging markets.", group="Filters", inline="regime"), input.int(title="Threshold", defval=20, minval=0, maxval=100, step=1, tooltip="Whether to use the ADX filter. Threshold for detecting Trending/Ranging markets.", group="Filters", inline="adx"))

// Filter object for filtering the ML predictions
Filter filter = Filter.new(
   filter_volatility(1, 10, filterSettings.useVolatilityFilter), 
   regime_filter(ohlc4, filterSettings.regimeThreshold, filterSettings.useRegimeFilter),
   filter_adx(settings.source, 14, filterSettings.adxThreshold, filterSettings.useAdxFilter)
  )

// Feature Variables: User-Defined Inputs for calculating Feature Series. 
f1_string = "RSI"
f1_paramA = 14
f1_paramB = 1
f2_string = "WT"
f2_paramA = 10
f2_paramB = 11
f3_string = "CCI"
f3_paramA = 20
f3_paramB = 1
f4_string = "ADX"
f4_paramA = 29
f4_paramB = 2
f5_string = "RSI"
f5_paramA = 9
f5_paramB = 1

// FeatureSeries Object: Calculated Feature Series based on Feature Variables
featureSeries = FeatureSeries.new(
   series_from(f1_string, close, high, low, hlc3, f1_paramA, f1_paramB), // f1
   series_from(f2_string, close, high, low, hlc3, f2_paramA, f2_paramB), // f2 
   series_from(f3_string, close, high, low, hlc3, f3_paramA, f3_paramB), // f3
   series_from(f4_string, close, high, low, hlc3, f4_paramA, f4_paramB), // f4
   series_from(f5_string, close, high, low, hlc3, f5_paramA, f5_paramB)  // f5
 )

// FeatureArrays Variables: Storage of Feature Series as Feature Arrays Optimized for ML
// Note: These arrays cannot be dynamically created within the FeatureArrays Object Initialization and thus must be set-up in advance.
var f1Array = array.new_float()
var f2Array = array.new_float()
var f3Array = array.new_float()
var f4Array = array.new_float()
var f5Array = array.new_float()
array.push(f1Array, featureSeries.f1)
array.push(f2Array, featureSeries.f2)
array.push(f3Array, featureSeries.f3)
array.push(f4Array, featureSeries.f4)
array.push(f5Array, featureSeries.f5)

// FeatureArrays Object: Storage of the calculated FeatureArrays into a single object
featureArrays = FeatureArrays.new(
  f1Array, // f1
  f2Array, // f2
  f3Array, // f3
  f4Array, // f4
  f5Array  // f5
 )

// Label Object: Used for classifying historical data as training data for the ML Model
Label direction = Label.new(
   long=1, 
   short=-1, 
   neutral=0
  )

// Derived from General Settings
maxBarsBackIndex = last_bar_index >= settings.maxBarsBack ? last_bar_index - settings.maxBarsBack : 0

// EMA Settings 
useEmaFilter = input.bool(title="Use EMA Filter", defval=false, group="Filters", inline="ema")
emaPeriod = input.int(title="Period", defval=200, minval=1, step=1, group="Filters", inline="ema", tooltip="The period of the EMA used for the EMA Filter.")
isEmaUptrend = useEmaFilter ? close > ta.ema(close, emaPeriod) : true
isEmaDowntrend = useEmaFilter ? close < ta.ema(close, emaPeriod) : true
useSmaFilter = input.bool(title="Use SMA Filter", defval=false, group="Filters", inline="sma")
smaPeriod = input.int(title="Period", defval=200, minval=1, step=1, group="Filters", inline="sma", tooltip="The period of the SMA used for the SMA Filter.")
isSmaUptrend = useSmaFilter ? close > ta.sma(close, smaPeriod) : true
isSmaDowntrend = useSmaFilter ? close < ta.sma(close, smaPeriod) : true

// Nadaraya-Watson Kernel Regression Settings
useKernelFilter = true
showKernelEstimate = true
useKernelSmoothing = false
h = input.int(8, 'Lookback Window', minval=3, tooltip='The number of bars used for the estimation. This is a sliding value that represents the most recent historical bars. Recommended range: 3-50', group="Kernel Settings", inline="kernel")
r = input.float(8., 'Relative Weighting', step=0.25, tooltip='Relative weighting of time frames. As this value approaches zero, the longer time frames will exert more influence on the estimation. As this value approaches infinity, the behavior of the Rational Quadratic Kernel will become identical to the Gaussian kernel. Recommended range: 0.25-25', group="Kernel Settings", inline="kernel")
x = input.int(25, "Regression Level", tooltip='Bar index on which to start regression. Controls how tightly fit the kernel estimate is to the data. Smaller values are a tighter fit. Larger values are a looser fit. Recommended range: 2-25', group="Kernel Settings", inline="kernel")
lag = input.int(2, "Lag", tooltip="Lag for crossover detection. Lower values result in earlier crossovers. Recommended range: 1-2", inline='1', group='Kernel Settings')

// Display Settings
showBarColors = input.bool(false, "Show Bar Colors", group="Display")
showBarPredictions = input.bool(false, "Show Bar Predictions", group="Display")
useAtrOffset = true
barPredictionsOffset = 0

// =================================
// ==== Next Bar Classification ====
// =================================

// This model specializes specifically in predicting the direction of price action over the course of the next 4 bars. 
// To avoid complications with the ML model, this value is hardcoded to 4 bars but support for other training lengths may be added in the future.
src = settings.source
y_train_series = src[4] < src[0] ? direction.short : src[4] > src[0] ? direction.long : direction.neutral
var y_train_array = array.new_int(0)

// Variables used for ML Logic
var predictions = array.new_float(0)
var prediction = 0.
var signal = direction.neutral
var distances = array.new_float(0)

array.push(y_train_array, y_train_series)

lastDistance = -1.0
size = math.min(settings.maxBarsBack-1, array.size(y_train_array)-1)
// Apply a hard cap to scanning for performance
cap = input.int(400, "Internal: ML Scan Cap", minval=50, maxval=2000, step=50, group="Performance")
// Control sampling density: evaluate every N bars (suggest multiples of label horizon=4)
sampleStride = input.int(4, "Sampling Stride (bars)", minval=1, maxval=32, group="Performance")
sizeLoop = math.min(math.min(settings.maxBarsBack-1, size), cap)

if bar_index >= maxBarsBackIndex
    for i = 0 to sizeLoop
        d = get_lorentzian_distance(i, settings.featureCount, featureSeries, featureArrays)
        // Sample every N bars (user-controlled) to balance speed and accuracy
        if d >= lastDistance and (i % sampleStride == 0)
            lastDistance := d
            array.push(distances, d)
            array.push(predictions, math.round(array.get(y_train_array, i)))
            if array.size(predictions) > settings.neighborsCount
                lastDistance := array.get(distances, math.round(settings.neighborsCount*3/4))
                array.shift(distances)
                array.shift(predictions)
    prediction := array.sum(predictions)

// ============================
// ==== Prediction Filters ====
// ============================

// User Defined Filters: Used for adjusting the frequency of the ML Model's predictions
filter_all = filter.volatility and filter.regime and filter.adx

// Filtered Signal: The model's prediction of future price movement direction with user-defined filters applied
signal := prediction > 0 and filter_all ? direction.long : prediction < 0 and filter_all ? direction.short : nz(signal[1])

// Bar-Count Filters: Represents strict filters based on a pre-defined holding period of 4 bars
var int barsHeld = 0
barsHeld := (signal != signal[1]) ? 0 : (barsHeld + 1)
isHeldFourBars = barsHeld == 4
isHeldLessThanFourBars = 0 < barsHeld and barsHeld < 4

// Fractal Filters: Derived from relative appearances of signals in a given time series fractal/segment with a default length of 4 bars
isDifferentSignalType = (signal != signal[1])
isEarlySignalFlip = (signal != signal[1]) and ((signal[1] != signal[2]) or (signal[2] != signal[3]) or (signal[3] != signal[4]))
isBuySignal = signal == direction.long and isEmaUptrend and isSmaUptrend
isSellSignal = signal == direction.short and isEmaDowntrend and isSmaDowntrend
isLastSignalBuy = signal[4] == direction.long and isEmaUptrend[4] and isSmaUptrend[4]
isLastSignalSell = signal[4] == direction.short and isEmaDowntrend[4] and isSmaDowntrend[4]
isNewBuySignal = isBuySignal and isDifferentSignalType
isNewSellSignal = isSellSignal and isDifferentSignalType

// Kernel Regression Filters: Filters based on Nadaraya-Watson Kernel Regression using the Rational Quadratic Kernel
// For more information on this technique refer to my other open source indicator located here: 
// https://www.tradingview.com/script/AWNvbPRM-Nadaraya-Watson-Rational-Quadratic-Kernel-Non-Repainting/

yhat1 = rationalQuadratic(settings.source, h, r, x)
yhat2 = gaussian(settings.source, h-lag, x)
kernelEstimate = yhat1
// Kernel Rates of Change
bool wasBearishRate = yhat1[2] > yhat1[1]
bool wasBullishRate = yhat1[2] < yhat1[1]
bool isBearishRate = yhat1[1] > yhat1
bool isBullishRate = yhat1[1] < yhat1
isBearishChange = isBearishRate and wasBullishRate
isBullishChange = isBullishRate and wasBearishRate
// Kernel Crossovers
bool isBullishCrossAlert = ta.crossover(yhat2, yhat1)
bool isBearishCrossAlert = ta.crossunder(yhat2, yhat1) 
bool isBullishSmooth = yhat2 >= yhat1
bool isBearishSmooth = yhat2 <= yhat1
// Kernel Colors
color colorByCross = isBullishSmooth ? color.new(#009988, 1) : color.new(#CC3311, 1)
color colorByRate = isBullishRate ? color.new(#009988, 1) : color.new(#CC3311, 1)
color plotColor = showKernelEstimate ? (useKernelSmoothing ? colorByCross : colorByRate) : color.new(#000000, 100)
plot(kernelEstimate, color=plotColor, linewidth=2, title="Kernel Regression Estimate")
// Alert Variables
bool alertBullish = useKernelSmoothing ? isBullishCrossAlert : isBullishChange
bool alertBearish = useKernelSmoothing ? isBearishCrossAlert : isBearishChange
// Bullish and Bearish Filters based on Kernel
isBullish = useKernelFilter ? (useKernelSmoothing ? isBullishSmooth : isBullishRate) : true
isBearish = useKernelFilter ? (useKernelSmoothing ? isBearishSmooth : isBearishRate) : true

// ===========================
// ==== Entries and Exits ====
// ===========================

// Entry Conditions: Booleans for ML Model Position Entries
baseStartLong = isNewBuySignal and isBullish and isEmaUptrend and isSmaUptrend
baseStartShort = isNewSellSignal and isBearish and isEmaDowntrend and isSmaDowntrend

// Edge controls to improve trade quality
// Default profile: Fusion V4 hardened preset from locked 10k-bar XRPUSDT 15m benchmark (2026-04-21)
useTrendXConf = input.bool(true,  title="Require Confirmation Trend (x)", group="Edge Controls")
minPredSum    = input.float(1.8,  title="Min Prediction Sum (strength)", minval=0.0, step=0.5, group="Edge Controls")
minBarsBetween = input.int(1, title="Cooldown Bars Between Entries", minval=0, group="Edge Controls")
useSignalFusion = input.bool(true, title="Use Signal Fusion", group="Edge Controls")
minFusionScore = input.int(1, title="Min Fusion Score", minval=0, maxval=4, group="Edge Controls")
useAtrFlipConfirm = input.bool(true, title="Use ATR Flip Confirm", group="Signal Fusion")
use3LineConfirm = input.bool(false, title="Use 3 Line Strike Confirm", group="Signal Fusion")
useEngulfingConfirm = input.bool(true, title="Use Engulfing Confirm", group="Signal Fusion")
useEmaCrossConfirm = input.bool(false, title="Use EMA Cross Confirm", group="Signal Fusion")
useFusionV2 = input.bool(false, title="Use Fusion V2 Soft Mode", group="Signal Fusion V2")
fusionBonusPerSignal = input.float(0.25, title="Fusion Bonus Per Signal", minval=0.0, step=0.05, group="Signal Fusion V2")
fusionMaxBonus = input.float(0.50, title="Fusion Max Bonus", minval=0.0, step=0.05, group="Signal Fusion V2")
useFusionV3 = input.bool(false, title="Use Fusion V3 Threshold Shaping", group="Signal Fusion V3")
fusionPenaltyPerMissing = input.float(0.25, title="Fusion Penalty Per Missing Signal", minval=0.0, step=0.05, group="Signal Fusion V3")
useFusionV4 = input.bool(true, title="Use Fusion V4 Residual Layer", group="Signal Fusion V4")
fusionV4MinAbsPrediction = input.float(2, title="Fusion V4 Min |Prediction|", minval=0.0, step=0.5, group="Signal Fusion V4")
fusionV4MaxAbsPrediction = input.float(4, title="Fusion V4 Max |Prediction|", minval=0.0, step=0.5, group="Signal Fusion V4")
fusionV4LongAtrWeight = input.float(-0.25, title="Fusion V4 Long ATR Weight", step=0.05, group="Signal Fusion V4")
fusionV4LongEngulfWeight = input.float(-0.25, title="Fusion V4 Long Engulf Weight", step=0.05, group="Signal Fusion V4")
fusionV4LongEmaWeight = input.float(0, title="Fusion V4 Long EMA Weight", step=0.05, group="Signal Fusion V4")
fusionV4ShortAtrWeight = input.float(-0.5, title="Fusion V4 Short ATR Weight", step=0.05, group="Signal Fusion V4")
fusionV4ShortEngulfWeight = input.float(-0.1, title="Fusion V4 Short Engulf Weight", step=0.05, group="Signal Fusion V4")
fusionV4ShortEmaWeight = input.float(0, title="Fusion V4 Short EMA Weight", step=0.05, group="Signal Fusion V4")
useSupertrendFilter = input.bool(true, title="Use Supertrend Filter", group="Phase 3: Supertrend")
useSupertrendEntryConfirm = input.bool(false, title="Require Supertrend Flip Confirm", group="Phase 3: Supertrend")
supertrendAtrLen = input.int(10, title="Supertrend ATR Length", minval=1, group="Phase 3: Supertrend")
supertrendFactor = input.float(1.5, title="Supertrend Factor", minval=0.1, step=0.1, group="Phase 3: Supertrend")

useAvwapContext = input.bool(false, title="Use AVWAP Context", group="Phase 3: AVWAP Context")
avwapSwingPeriod = input.int(50, title="AVWAP Swing Period", minval=2, group="Phase 3: AVWAP Context")
avwapReclaimFreshBars = input.int(6, title="AVWAP Reclaim Fresh Bars", minval=1, group="Phase 3: AVWAP Context")
avwapMaxDistanceAtr = input.float(1.0, title="AVWAP Max Distance ATR", minval=0.1, step=0.1, group="Phase 3: AVWAP Context")
avwapMaxAnchorAge = input.int(100, title="AVWAP Max Anchor Age", minval=1, group="Phase 3: AVWAP Context")
avwapRequireReclaimForEntry = input.bool(false, title="Require AVWAP Reclaim For Entry", group="Phase 3: AVWAP Context")

useChannelContext = input.bool(false, title="Use Breakout Context", group="Phase 3: Breakout Context")
channelDetectLength = input.int(18, title="Channel Detect Length", minval=2, group="Phase 3: Breakout Context")
channelCompressionThreshold = input.float(0.35, title="Channel Compression Threshold", minval=0.0, step=0.05, group="Phase 3: Breakout Context")
channelBreakoutFreshBars = input.int(4, title="Channel Breakout Fresh Bars", minval=1, group="Phase 3: Breakout Context")
channelEnableRetest = input.bool(false, title="Enable Channel Retest", group="Phase 3: Breakout Context")
channelRetestFreshBars = input.int(6, title="Channel Retest Fresh Bars", minval=1, group="Phase 3: Breakout Context")
channelHostileBlocksEntry = input.bool(true, title="Channel Hostile Blocks Entry", group="Phase 3: Breakout Context")

useContextAggregator = input.bool(false, title="Use Context Aggregator", group="Phase 3: Context Aggregator")
contextStrictRequireChannel = input.bool(false, title="Strict Require Channel", group="Phase 3: Context Aggregator")
contextBoostAddsToStrength = input.bool(false, title="Context Boost Adds To Strength", group="Phase 3: Context Aggregator")
contextBoostValue = input.float(0.25, title="Context Boost Value", step=0.05, group="Phase 3: Context Aggregator")
contextHostileBlocksEntry = input.bool(true, title="Context Hostile Blocks Entry", group="Phase 3: Context Aggregator")

useContextExitShaping = input.bool(false, title="Use Context Exit Shaping", group="Phase 3: Context Exit Shaping")
contextTightenTrailOnCaution = input.bool(false, title="Tighten Trail On Caution", group="Phase 3: Context Exit Shaping")
contextTrailTightenFactor = input.float(0.75, title="Context Trail Tighten Factor", minval=0.1, maxval=1.0, step=0.05, group="Phase 3: Context Exit Shaping")
contextAllowEarlySignalExit = input.bool(false, title="Allow Early Signal Exit", group="Phase 3: Context Exit Shaping")

useSqueezeContext = input.bool(true, title="Use Squeeze Context", group="Phase 3: Squeeze Context")
squeezeLength = input.int(20, title="Squeeze Length", minval=2, group="Phase 3: Squeeze Context")
squeezeBbMult = input.float(2.0, title="BB Multiplier", minval=0.1, step=0.1, group="Phase 3: Squeeze Context")
squeezeKcMult = input.float(1.5, title="KC Multiplier", minval=0.1, step=0.1, group="Phase 3: Squeeze Context")
squeezeReleaseFreshBars = input.int(4, title="Squeeze Release Fresh Bars", minval=1, group="Phase 3: Squeeze Context")
squeezeBoostValue = input.float(0.25, title="Squeeze Boost Value", minval=0.0, step=0.05, group="Phase 3: Squeeze Context")

useDivergenceContext = input.bool(true, title="Use Divergence Context", group="Phase 3: Divergence Context")
divRsiLen = input.int(21, title="Divergence RSI Length", minval=1, group="Phase 3: Divergence Context")
divPivotLeft = input.int(3, title="Divergence Pivot Left", minval=1, group="Phase 3: Divergence Context")
divPivotRight = input.int(3, title="Divergence Pivot Right", minval=1, group="Phase 3: Divergence Context")
divFreshBars = input.int(8, title="Divergence Fresh Bars", minval=1, group="Phase 3: Divergence Context")
divLongBoostValue = input.float(0.7, title="Divergence Long Boost", minval=0.0, step=0.05, group="Phase 3: Divergence Context")
divShortBoostValue = input.float(0.7, title="Divergence Short Boost", minval=0.0, step=0.05, group="Phase 3: Divergence Context")
divCautionPenaltyValue = input.float(0.0, title="Divergence Caution Penalty", minval=0.0, step=0.05, group="Phase 3: Divergence Context")

useFailedFollowThroughTighten = input.bool(false, title="Use Failed Follow-Through Tighten", group="Phase 4: Exit-State Research")
followThroughBars = input.int(4, title="Follow-Through Bars", minval=1, group="Phase 4: Exit-State Research")
followThroughMinProgressAtr = input.float(0.75, title="Follow-Through Min Progress ATR", minval=0.0, step=0.25, group="Phase 4: Exit-State Research")
followThroughTightenTrailAtrMult = input.float(0.75, title="Follow-Through Tighten Trail ATR x", minval=0.1, step=0.05, group="Phase 4: Exit-State Research")
useTimeStop = input.bool(false, title="Use Time Stop", group="Phase 4: Exit-State Research")
timeStopBars = input.int(8, title="Time Stop Bars", minval=1, group="Phase 4: Exit-State Research")
timeStopMinUnrealizedAtr = input.float(0.5, title="Time Stop Min Unrealized ATR", minval=0.0, step=0.25, group="Phase 4: Exit-State Research")
useContextCautionTighten = input.bool(false, title="Use Context Caution Tighten", group="Phase 4: Exit-State Research")
contextCautionDelta = input.float(0.5, title="Context Caution Delta", minval=0.0, step=0.25, group="Phase 4: Exit-State Research")
contextCautionTrailAtrMult = input.float(0.75, title="Context Caution Trail ATR x", minval=0.1, step=0.05, group="Phase 4: Exit-State Research")
usePartialDerisk = input.bool(false, title="Use Partial De-Risk", group="Phase 4: Exit-State Research")
partialDeriskAtR = input.float(1.0, title="Partial De-Risk At R", minval=0.0, step=0.25, group="Phase 4: Exit-State Research")
partialDeriskClosePct = input.float(50.0, title="Partial De-Risk Close Pct", minval=0.0, maxval=100.0, step=5.0, group="Phase 4: Exit-State Research")
usePostEntrySqueezeCollapseTighten = input.bool(false, title="Use Post-Entry Squeeze Collapse Tighten", group="Phase 4: Exit-State Research")
postEntrySqueezeCollapseBars = input.int(4, title="Post-Entry Squeeze Collapse Bars", minval=1, group="Phase 4: Exit-State Research")
postEntrySqueezeCollapseTrailAtrMult = input.float(0.75, title="Post-Entry Squeeze Collapse Trail ATR x", minval=0.1, step=0.05, group="Phase 4: Exit-State Research")
useAdverseDivergenceTighten = input.bool(false, title="Use Adverse Divergence Tighten", group="Phase 4: Exit-State Research")
adverseDivergenceBars = input.int(6, title="Adverse Divergence Bars", minval=1, group="Phase 4: Exit-State Research")
adverseDivergenceTrailAtrMult = input.float(0.75, title="Adverse Divergence Trail ATR x", minval=0.1, step=0.05, group="Phase 4: Exit-State Research")

fusion3LineBull = close[3] < open[3] and close[2] < open[2] and close[1] < open[1] and close > open[1]
fusion3LineBear = close[3] > open[3] and close[2] > open[2] and close[1] > open[1] and close < open[1]
fusionEngulfingBull = open <= close[1] and open < open[1] and close > open[1]
fusionEngulfingBear = open >= close[1] and open > open[1] and close < open[1]
fusionEmaSlow = ta.ema(close, 62)
fusionEmaFast = ta.ema(close, 38)
fusionEmaCrossBull = fusionEmaFast > fusionEmaSlow and close[1] < fusionEmaFast and close > fusionEmaFast
fusionEmaCrossBear = fusionEmaFast < fusionEmaSlow and close[1] > fusionEmaFast and close < fusionEmaFast
fusionAtrFlipBull = buySignal
fusionAtrFlipBear = sellSignal
fusionEnabledCount = (useAtrFlipConfirm ? 1 : 0) + (use3LineConfirm ? 1 : 0) + (useEngulfingConfirm ? 1 : 0) + (useEmaCrossConfirm ? 1 : 0)
longFusionScore = (useAtrFlipConfirm and fusionAtrFlipBull ? 1 : 0) + (use3LineConfirm and fusion3LineBull ? 1 : 0) + (useEngulfingConfirm and fusionEngulfingBull ? 1 : 0) + (useEmaCrossConfirm and fusionEmaCrossBull ? 1 : 0)
shortFusionScore = (useAtrFlipConfirm and fusionAtrFlipBear ? 1 : 0) + (use3LineConfirm and fusion3LineBear ? 1 : 0) + (useEngulfingConfirm and fusionEngulfingBear ? 1 : 0) + (useEmaCrossConfirm and fusionEmaCrossBear ? 1 : 0)
longFusionBonus = useSignalFusion and (useFusionV2 or useFusionV3) ? math.min(fusionMaxBonus, longFusionScore * fusionBonusPerSignal) : 0.0
shortFusionBonus = useSignalFusion and (useFusionV2 or useFusionV3) ? math.min(fusionMaxBonus, shortFusionScore * fusionBonusPerSignal) : 0.0
longFusionPenalty = useSignalFusion and useFusionV3 ? math.max(0.0, fusionEnabledCount - longFusionScore) * fusionPenaltyPerMissing : 0.0
shortFusionPenalty = useSignalFusion and useFusionV3 ? math.max(0.0, fusionEnabledCount - shortFusionScore) * fusionPenaltyPerMissing : 0.0
fusionV4RangeActive = useSignalFusion and useFusionV4 and math.abs(prediction) >= fusionV4MinAbsPrediction and math.abs(prediction) <= fusionV4MaxAbsPrediction
longFusionV4Residual = fusionV4RangeActive ? (useAtrFlipConfirm and fusionAtrFlipBull ? fusionV4LongAtrWeight : 0.0) + (useEngulfingConfirm and fusionEngulfingBull ? fusionV4LongEngulfWeight : 0.0) + (useEmaCrossConfirm and fusionEmaCrossBull ? fusionV4LongEmaWeight : 0.0) : 0.0
shortFusionV4Residual = fusionV4RangeActive ? (useAtrFlipConfirm and fusionAtrFlipBear ? fusionV4ShortAtrWeight : 0.0) + (useEngulfingConfirm and fusionEngulfingBear ? fusionV4ShortEngulfWeight : 0.0) + (useEmaCrossConfirm and fusionEmaCrossBear ? fusionV4ShortEmaWeight : 0.0) : 0.0
effectiveLongStrength = prediction + longFusionBonus - longFusionPenalty + longFusionV4Residual
effectiveShortStrength = -prediction + shortFusionBonus - shortFusionPenalty + shortFusionV4Residual
longFusionPass = (useFusionV2 or useFusionV3 or useFusionV4) ? true : (not useSignalFusion or minFusionScore <= 0 or fusionEnabledCount == 0 or longFusionScore >= minFusionScore)
shortFusionPass = (useFusionV2 or useFusionV3 or useFusionV4) ? true : (not useSignalFusion or minFusionScore <= 0 or fusionEnabledCount == 0 or shortFusionScore >= minFusionScore)

supertrendAtr = ta.atr(supertrendAtrLen)
supertrendUp = hl2 - supertrendFactor * supertrendAtr
supertrendUp1 = nz(supertrendUp[1], supertrendUp)
supertrendUp := close[1] > supertrendUp1 ? math.max(supertrendUp, supertrendUp1) : supertrendUp
supertrendDn = hl2 + supertrendFactor * supertrendAtr
supertrendDn1 = nz(supertrendDn[1], supertrendDn)
supertrendDn := close[1] < supertrendDn1 ? math.min(supertrendDn, supertrendDn1) : supertrendDn
supertrendTrend = 1
supertrendTrend := nz(supertrendTrend[1], supertrendTrend)
supertrendTrend := supertrendTrend == -1 and close > supertrendDn1 ? 1 : supertrendTrend == 1 and close < supertrendUp1 ? -1 : supertrendTrend
supertrendBull = supertrendTrend == 1
supertrendBear = supertrendTrend == -1
supertrendFlipBull = supertrendBull and supertrendTrend[1] == -1
supertrendFlipBear = supertrendBear and supertrendTrend[1] == 1
supertrendLine = supertrendBull ? supertrendUp : supertrendDn
supertrendPassLong = (not useSupertrendFilter or supertrendBull) and (not useSupertrendEntryConfirm or supertrendFlipBull)
supertrendPassShort = (not useSupertrendFilter or supertrendBear) and (not useSupertrendEntryConfirm or supertrendFlipBear)

contextAtr = ta.atr(14)

avwapPivotHigh = ta.pivothigh(high, avwapSwingPeriod, avwapSwingPeriod)
avwapPivotLow = ta.pivotlow(low, avwapSwingPeriod, avwapSwingPeriod)
var int avwapAnchorBar = na
var float avwapPv = na
var float avwapVol = na
newAvwapAnchor = not na(avwapPivotHigh) or not na(avwapPivotLow)
if newAvwapAnchor
    avwapAnchorBar := bar_index - avwapSwingPeriod
    avwapPv := hlc3[avwapSwingPeriod] * volume[avwapSwingPeriod]
    avwapVol := volume[avwapSwingPeriod]
else
    avwapPv := nz(avwapPv[1]) + hlc3 * volume
    avwapVol := nz(avwapVol[1]) + volume

barsSinceAvwapAnchor = na(avwapAnchorBar) ? 100000 : bar_index - avwapAnchorBar
avwapValue = avwapVol > 0 ? avwapPv / avwapVol : na
avwapDistanceNorm = contextAtr > 0 and not na(avwapValue) ? math.abs(close - avwapValue) / contextAtr : 0.0
avwapBullBias = useAvwapContext and close >= avwapValue
avwapBearBias = useAvwapContext and close <= avwapValue
avwapReclaimBull = useAvwapContext and ta.barssince(ta.crossover(close, avwapValue)) <= avwapReclaimFreshBars
avwapReclaimBear = useAvwapContext and ta.barssince(ta.crossunder(close, avwapValue)) <= avwapReclaimFreshBars
avwapLongOk = not useAvwapContext or ((avwapBullBias or (avwapRequireReclaimForEntry ? avwapReclaimBull : true)) and avwapDistanceNorm <= avwapMaxDistanceAtr and barsSinceAvwapAnchor <= avwapMaxAnchorAge)
avwapShortOk = not useAvwapContext or ((avwapBearBias or (avwapRequireReclaimForEntry ? avwapReclaimBear : true)) and avwapDistanceNorm <= avwapMaxDistanceAtr and barsSinceAvwapAnchor <= avwapMaxAnchorAge)

channelUpper = ta.highest(high, channelDetectLength)
channelLower = ta.lowest(low, channelDetectLength)
channelWidthNorm = contextAtr > 0 ? (channelUpper - channelLower) / contextAtr : 0.0
channelCompressionScore = channelWidthNorm > 0 ? 1 / channelWidthNorm : 0.0
channelCompressed = useChannelContext and channelWidthNorm <= channelCompressionThreshold
channelBullBreakFresh = useChannelContext and channelCompressed[1] and ta.barssince(close > channelUpper[1]) <= channelBreakoutFreshBars
channelBearBreakFresh = useChannelContext and channelCompressed[1] and ta.barssince(close < channelLower[1]) <= channelBreakoutFreshBars
channelRetestBull = useChannelContext and channelEnableRetest and ta.barssince(low <= channelUpper and close >= channelUpper) <= channelRetestFreshBars
channelRetestBear = useChannelContext and channelEnableRetest and ta.barssince(high >= channelLower and close <= channelLower) <= channelRetestFreshBars
channelLongBoost = channelBullBreakFresh or channelRetestBull
channelShortBoost = channelBearBreakFresh or channelRetestBear
channelLongHostile = useChannelContext and channelBearBreakFresh
channelShortHostile = useChannelContext and channelBullBreakFresh

contextLongBlocked = useContextAggregator and ((not avwapLongOk) or (contextStrictRequireChannel and not channelLongBoost) or ((channelHostileBlocksEntry or contextHostileBlocksEntry) and channelLongHostile))
contextShortBlocked = useContextAggregator and ((not avwapShortOk) or (contextStrictRequireChannel and not channelShortBoost) or ((channelHostileBlocksEntry or contextHostileBlocksEntry) and channelShortHostile))
contextLongQualify = not useContextAggregator ? true : avwapLongOk
contextShortQualify = not useContextAggregator ? true : avwapShortOk
contextLongBoost = not useContextAggregator ? 0.0 : (channelLongBoost and contextBoostAddsToStrength ? contextBoostValue : 0.0)
contextShortBoost = not useContextAggregator ? 0.0 : (channelShortBoost and contextBoostAddsToStrength ? contextBoostValue : 0.0)
contextLongCaution = useContextAggregator and (not avwapLongOk or channelLongHostile)
contextShortCaution = useContextAggregator and (not avwapShortOk or channelShortHostile)

// Standalone mirrors:
// pine/to-be-implement/Squeeze Momentum Indicator.pine
// pine/to-be-implement/Divergence For Many Indicators.pine
squeezeBasis = ta.sma(close, squeezeLength)
squeezeDeviation = ta.stdev(close, squeezeLength)
squeezeBbUpper = squeezeBasis + squeezeBbMult * squeezeDeviation
squeezeBbLower = squeezeBasis - squeezeBbMult * squeezeDeviation
squeezeKcBasis = ta.ema(close, squeezeLength)
squeezeKcRange = ta.atr(squeezeLength)
squeezeKcUpper = squeezeKcBasis + squeezeKcMult * squeezeKcRange
squeezeKcLower = squeezeKcBasis - squeezeKcMult * squeezeKcRange
squeezeOn = useSqueezeContext and squeezeBbUpper < squeezeKcUpper and squeezeBbLower > squeezeKcLower
squeezeReleaseBull = useSqueezeContext and not squeezeOn and squeezeOn[1] and close > close[1]
squeezeReleaseBear = useSqueezeContext and not squeezeOn and squeezeOn[1] and close < close[1]
squeezeBullFresh = useSqueezeContext and not na(ta.barssince(squeezeReleaseBull)) and ta.barssince(squeezeReleaseBull) <= squeezeReleaseFreshBars
squeezeBearFresh = useSqueezeContext and not na(ta.barssince(squeezeReleaseBear)) and ta.barssince(squeezeReleaseBear) <= squeezeReleaseFreshBars
squeezeLongBoost = (squeezeReleaseBull or squeezeBullFresh) ? squeezeBoostValue : 0.0
squeezeShortBoost = (squeezeReleaseBear or squeezeBearFresh) ? squeezeBoostValue : 0.0
squeezeLongCaution = useSqueezeContext and squeezeOn and not squeezeReleaseBull
squeezeShortCaution = useSqueezeContext and squeezeOn and not squeezeReleaseBear

divRsi = ta.rsi(close, divRsiLen)
divPivotLow = ta.pivotlow(low, divPivotLeft, divPivotRight)
divPivotHigh = ta.pivothigh(high, divPivotLeft, divPivotRight)
var float divPrevPriceLow = na
var float divPrevRsiLow = na
var float divPrevPriceHigh = na
var float divPrevRsiHigh = na
divBullConfirmed = false
divBearConfirmed = false
if not na(divPivotLow)
    divCurrPriceLow = divPivotLow
    divCurrRsiLow = divRsi[divPivotRight]
    divBullConfirmed := not na(divPrevPriceLow) and divCurrPriceLow < divPrevPriceLow and divCurrRsiLow > divPrevRsiLow
    divPrevPriceLow := divCurrPriceLow
    divPrevRsiLow := divCurrRsiLow
if not na(divPivotHigh)
    divCurrPriceHigh = divPivotHigh
    divCurrRsiHigh = divRsi[divPivotRight]
    divBearConfirmed := not na(divPrevPriceHigh) and divCurrPriceHigh > divPrevPriceHigh and divCurrRsiHigh < divPrevRsiHigh
    divPrevPriceHigh := divCurrPriceHigh
    divPrevRsiHigh := divCurrRsiHigh
divBullFresh = useDivergenceContext and (divBullConfirmed or (not na(ta.barssince(divBullConfirmed)) and ta.barssince(divBullConfirmed) <= divFreshBars))
divBearFresh = useDivergenceContext and (divBearConfirmed or (not na(ta.barssince(divBearConfirmed)) and ta.barssince(divBearConfirmed) <= divFreshBars))
divLongBoost = useDivergenceContext and divBullConfirmed ? divLongBoostValue : 0.0
divShortBoost = useDivergenceContext and divBearConfirmed ? divShortBoostValue : 0.0
divLongCaution = useDivergenceContext and (divBearConfirmed or divBearFresh)
divShortCaution = useDivergenceContext and (divBullConfirmed or divBullFresh)
divLongPenalty = divLongCaution ? divCautionPenaltyValue : 0.0
divShortPenalty = divShortCaution ? divCautionPenaltyValue : 0.0

contextLongCaution := contextLongCaution or squeezeLongCaution or divLongCaution
contextShortCaution := contextShortCaution or squeezeShortCaution or divShortCaution
effectiveLongStrength := effectiveLongStrength + contextLongBoost + squeezeLongBoost + divLongBoost
effectiveShortStrength := effectiveShortStrength + contextShortBoost + squeezeShortBoost + divShortBoost
requiredLongStrength = math.max(0.0, minPredSum + divLongPenalty)
requiredShortStrength = math.max(0.0, minPredSum + divShortPenalty)
predLongStrengthPass = effectiveLongStrength >= requiredLongStrength
predShortStrengthPass = effectiveShortStrength >= requiredShortStrength

var int lastEntryBar = na
cooldownOk = na(lastEntryBar) or (bar_index - lastEntryBar >= minBarsBetween)

startLongTrade = baseStartLong and (not useTrendXConf or trendx == 1) and predLongStrengthPass and cooldownOk and longFusionPass and supertrendPassLong and contextLongQualify and not contextLongBlocked
startShortTrade = baseStartShort and (not useTrendXConf or trendx == -1) and predShortStrengthPass and cooldownOk and shortFusionPass and supertrendPassShort and contextShortQualify and not contextShortBlocked

// Dynamic Exit Conditions: Booleans for ML Model Position Exits based on Fractal Filters and Kernel Regression Filters
lastSignalWasBullish = ta.barssince(startLongTrade) < ta.barssince(startShortTrade)
lastSignalWasBearish = ta.barssince(startShortTrade) < ta.barssince(startLongTrade)
barsSinceRedEntry = ta.barssince(startShortTrade)
barsSinceRedExit = ta.barssince(alertBullish)
barsSinceGreenEntry = ta.barssince(startLongTrade)
barsSinceGreenExit = ta.barssince(alertBearish)
isValidShortExit = barsSinceRedExit > barsSinceRedEntry
isValidLongExit = barsSinceGreenExit > barsSinceGreenEntry
endLongTradeDynamic = (isBearishChange and isValidLongExit[1])
endShortTradeDynamic = (isBullishChange and isValidShortExit[1])

// Fixed Exit Conditions: Booleans for ML Model Position Exits based on a Bar-Count Filters
endLongTradeStrict = ((isHeldFourBars and isLastSignalBuy) or (isHeldLessThanFourBars and isNewSellSignal and isLastSignalBuy)) and startLongTrade[4]
endShortTradeStrict = ((isHeldFourBars and isLastSignalSell) or (isHeldLessThanFourBars and isNewBuySignal and isLastSignalSell)) and startShortTrade[4]
isDynamicExitValid = not useEmaFilter and not useSmaFilter and not useKernelSmoothing
contextAllowLongEarlyExit = useContextExitShaping and contextAllowEarlySignalExit and contextLongCaution
contextAllowShortEarlyExit = useContextExitShaping and contextAllowEarlySignalExit and contextShortCaution
endLongTrade = (settings.useDynamicExits and isDynamicExitValid ? endLongTradeDynamic : endLongTradeStrict) or (contextAllowLongEarlyExit and endLongTradeDynamic)
endShortTrade = (settings.useDynamicExits and isDynamicExitValid ? endShortTradeDynamic : endShortTradeStrict) or (contextAllowShortEarlyExit and endShortTradeDynamic)

// ===========================
// ==== Signal Engine      ====
// ===========================
// Removed strategy tester calls (strategy.entry/exit/close).
// Keep lightweight simulated position state for alerts and stop/target visualization.
enableStrategy = input.bool(true, title="Enable Signal Engine", group="Strategy")
useStopsTP     = input.bool(true,  title="Use ATR Stop/Target", group="Strategy")
riskAtrLen     = input.int(14,     title="ATR Length", minval=1, group="Strategy")
slAtrMult      = input.float(0.5,  title="SL ATR x", minval=0.1, step=0.1, group="Strategy")
tpAtrMult      = input.float(7.6,  title="TP ATR x (1:1 R:R by default)", minval=0.1, step=0.1, group="Strategy")
useSignalExits = input.bool(false, title="Use Signal-Based Exits (in addition to SL/TP)", group="Strategy")
useTrailingStop = input.bool(true, title="Use ATR Trailing Stop", group="Strategy")
trailAtrLen = input.int(14, title="Trail ATR Length", minval=1, group="Strategy")
trailAtrMult = input.float(1, title="Trail ATR x", minval=0.1, step=0.1, group="Strategy")
trailActivateR = input.float(0.5, title="Trail Activate at R", minval=0.0, step=0.25, group="Strategy")

var int simPos = 0
var float simEntryPrice = na
var float atrNow = na
var float trailAtrNow = na
var float simRiskDistance = na
var float simBaseStop = na
var float simTakeProfit = na
var float simTrailStop = na
var float simEntryContextScore = na
var bool simEntrySqueezeOn = false
var float activeStop = na
var float activeTakeProfit = na

atrNow := ta.atr(riskAtrLen)
trailAtrNow := ta.atr(trailAtrLen)

exitStateLongContextScore = (not avwapLongOk ? 1.0 : 0.0) + (channelLongHostile ? 1.0 : 0.0) + (squeezeLongCaution ? 1.0 : 0.0) + (divLongCaution ? 1.0 : 0.0)
exitStateShortContextScore = (not avwapShortOk ? 1.0 : 0.0) + (channelShortHostile ? 1.0 : 0.0) + (squeezeShortCaution ? 1.0 : 0.0) + (divShortCaution ? 1.0 : 0.0)

if enableStrategy
    if startLongTrade and simPos <= 0
        simPos := 1
        simEntryPrice := close
        simRiskDistance := slAtrMult * atrNow
        simBaseStop := useStopsTP ? close - simRiskDistance : na
        simTakeProfit := useStopsTP ? close + tpAtrMult * atrNow : na
        simTrailStop := na
        simEntryContextScore := exitStateLongContextScore
        simEntrySqueezeOn := squeezeOn
        lastEntryBar := bar_index
    if startShortTrade and simPos >= 0
        simPos := -1
        simEntryPrice := close
        simRiskDistance := slAtrMult * atrNow
        simBaseStop := useStopsTP ? close + simRiskDistance : na
        simTakeProfit := useStopsTP ? close - tpAtrMult * atrNow : na
        simTrailStop := na
        simEntryContextScore := exitStateShortContextScore
        simEntrySqueezeOn := squeezeOn
        lastEntryBar := bar_index

barsInTrade = simPos != 0 and not na(lastEntryBar) ? bar_index - lastEntryBar : na

longFailedFollowThroughTighten = useFailedFollowThroughTighten and simPos == 1 and not na(simEntryPrice) and not na(barsInTrade) and barsInTrade >= followThroughBars and atrNow > 0 and ((high - simEntryPrice) / atrNow) < followThroughMinProgressAtr
shortFailedFollowThroughTighten = useFailedFollowThroughTighten and simPos == -1 and not na(simEntryPrice) and not na(barsInTrade) and barsInTrade >= followThroughBars and atrNow > 0 and ((simEntryPrice - low) / atrNow) < followThroughMinProgressAtr

longTimeStopExit = useTimeStop and simPos == 1 and not na(simEntryPrice) and not na(barsInTrade) and barsInTrade >= timeStopBars and atrNow > 0 and ((close - simEntryPrice) / atrNow) <= timeStopMinUnrealizedAtr
shortTimeStopExit = useTimeStop and simPos == -1 and not na(simEntryPrice) and not na(barsInTrade) and barsInTrade >= timeStopBars and atrNow > 0 and ((simEntryPrice - close) / atrNow) <= timeStopMinUnrealizedAtr

longContextCautionTighten = useContextCautionTighten and simPos == 1 and not na(simEntryContextScore) and (exitStateLongContextScore - simEntryContextScore) >= contextCautionDelta
shortContextCautionTighten = useContextCautionTighten and simPos == -1 and not na(simEntryContextScore) and (exitStateShortContextScore - simEntryContextScore) >= contextCautionDelta

longPartialDeriskTriggered = usePartialDerisk and simPos == 1 and not na(simEntryPrice) and not na(simRiskDistance) and simRiskDistance > 0 and ((close - simEntryPrice) / simRiskDistance) >= partialDeriskAtR
shortPartialDeriskTriggered = usePartialDerisk and simPos == -1 and not na(simEntryPrice) and not na(simRiskDistance) and simRiskDistance > 0 and ((simEntryPrice - close) / simRiskDistance) >= partialDeriskAtR

longPostEntrySqueezeCollapseTighten = usePostEntrySqueezeCollapseTighten and simPos == 1 and not na(barsInTrade) and barsInTrade <= postEntrySqueezeCollapseBars and simEntrySqueezeOn and not squeezeOn
shortPostEntrySqueezeCollapseTighten = usePostEntrySqueezeCollapseTighten and simPos == -1 and not na(barsInTrade) and barsInTrade <= postEntrySqueezeCollapseBars and simEntrySqueezeOn and not squeezeOn

longAdverseDivergenceTighten = useAdverseDivergenceTighten and simPos == 1 and not na(barsInTrade) and barsInTrade <= adverseDivergenceBars and divLongCaution
shortAdverseDivergenceTighten = useAdverseDivergenceTighten and simPos == -1 and not na(barsInTrade) and barsInTrade <= adverseDivergenceBars and divShortCaution

longTrailAtrMultInForce = trailAtrMult
shortTrailAtrMultInForce = trailAtrMult

if contextLongCaution and useContextExitShaping and contextTightenTrailOnCaution
    longTrailAtrMultInForce := math.min(longTrailAtrMultInForce, trailAtrMult * contextTrailTightenFactor)
if longFailedFollowThroughTighten
    longTrailAtrMultInForce := math.min(longTrailAtrMultInForce, followThroughTightenTrailAtrMult)
if longContextCautionTighten
    longTrailAtrMultInForce := math.min(longTrailAtrMultInForce, contextCautionTrailAtrMult)
if longPartialDeriskTriggered
    longTrailAtrMultInForce := math.min(longTrailAtrMultInForce, math.max(0.1, trailAtrMult * (1.0 - partialDeriskClosePct / 100.0)))
if longPostEntrySqueezeCollapseTighten
    longTrailAtrMultInForce := math.min(longTrailAtrMultInForce, postEntrySqueezeCollapseTrailAtrMult)
if longAdverseDivergenceTighten
    longTrailAtrMultInForce := math.min(longTrailAtrMultInForce, adverseDivergenceTrailAtrMult)

if contextShortCaution and useContextExitShaping and contextTightenTrailOnCaution
    shortTrailAtrMultInForce := math.min(shortTrailAtrMultInForce, trailAtrMult * contextTrailTightenFactor)
if shortFailedFollowThroughTighten
    shortTrailAtrMultInForce := math.min(shortTrailAtrMultInForce, followThroughTightenTrailAtrMult)
if shortContextCautionTighten
    shortTrailAtrMultInForce := math.min(shortTrailAtrMultInForce, contextCautionTrailAtrMult)
if shortPartialDeriskTriggered
    shortTrailAtrMultInForce := math.min(shortTrailAtrMultInForce, math.max(0.1, trailAtrMult * (1.0 - partialDeriskClosePct / 100.0)))
if shortPostEntrySqueezeCollapseTighten
    shortTrailAtrMultInForce := math.min(shortTrailAtrMultInForce, postEntrySqueezeCollapseTrailAtrMult)
if shortAdverseDivergenceTighten
    shortTrailAtrMultInForce := math.min(shortTrailAtrMultInForce, adverseDivergenceTrailAtrMult)

longTrailActive = useTrailingStop and simPos == 1 and not na(simRiskDistance) and close >= simEntryPrice + trailActivateR * simRiskDistance
shortTrailActive = useTrailingStop and simPos == -1 and not na(simRiskDistance) and close <= simEntryPrice - trailActivateR * simRiskDistance
longTrailCandidate = longTrailActive ? close - longTrailAtrMultInForce * trailAtrNow : na
shortTrailCandidate = shortTrailActive ? close + shortTrailAtrMultInForce * trailAtrNow : na

if simPos == 1 and longTrailActive
    simTrailStop := na(simTrailStop) ? longTrailCandidate : math.max(simTrailStop, longTrailCandidate)
if simPos == -1 and shortTrailActive
    simTrailStop := na(simTrailStop) ? shortTrailCandidate : math.min(simTrailStop, shortTrailCandidate)

activeStop := simPos == 1 ? (na(simTrailStop) ? simBaseStop : math.max(simBaseStop, simTrailStop)) : simPos == -1 ? (na(simTrailStop) ? simBaseStop : math.min(simBaseStop, simTrailStop)) : na
activeTakeProfit := simPos != 0 ? simTakeProfit : na

longStopHit = useStopsTP and simPos == 1 and not na(activeStop) and (ta.crossunder(close, activeStop) or close <= activeStop)
longTakeHit = useStopsTP and simPos == 1 and not na(activeTakeProfit) and (ta.crossover(close, activeTakeProfit) or close >= activeTakeProfit)
shortStopHit = useStopsTP and simPos == -1 and not na(activeStop) and (ta.crossover(close, activeStop) or close >= activeStop)
shortTakeHit = useStopsTP and simPos == -1 and not na(activeTakeProfit) and (ta.crossunder(close, activeTakeProfit) or close <= activeTakeProfit)
longTrailExit = useTrailingStop and simPos == 1 and not na(simTrailStop) and longStopHit
shortTrailExit = useTrailingStop and simPos == -1 and not na(simTrailStop) and shortStopHit

if simPos == 1 and ((useSignalExits and endLongTrade) or longStopHit or longTakeHit or longTimeStopExit)
    simPos := 0
    simEntryPrice := na
    simRiskDistance := na
    simBaseStop := na
    simTakeProfit := na
    simTrailStop := na
    simEntryContextScore := na
    simEntrySqueezeOn := false
if simPos == -1 and ((useSignalExits and endShortTrade) or shortStopHit or shortTakeHit or shortTimeStopExit)
    simPos := 0
    simEntryPrice := na
    simRiskDistance := na
    simBaseStop := na
    simTakeProfit := na
    simTrailStop := na
    simEntryContextScore := na
    simEntrySqueezeOn := false

// =========================
// ======== Alerts =========
// =========================
longEntryAlert  = enableStrategy and simPos == 1 and simPos[1] != 1
shortEntryAlert = enableStrategy and simPos == -1 and simPos[1] != -1
alertcondition(longEntryAlert,  title="Long Position Opened",  message="Long opened on {{ticker}} {{interval}} @ {{close}}")
alertcondition(shortEntryAlert, title="Short Position Opened", message="Short opened on {{ticker}} {{interval}} @ {{close}}")

longExitAlert  = enableStrategy and simPos == 0 and simPos[1] == 1 and (endLongTrade or longTimeStopExit)
shortExitAlert = enableStrategy and simPos == 0 and simPos[1] == -1 and (endShortTrade or shortTimeStopExit)
alertcondition(longExitAlert,  title="Long Exit",  message="Long exit on {{ticker}} {{interval}} @ {{close}}")
alertcondition(shortExitAlert, title="Short Exit", message="Short exit on {{ticker}} {{interval}} @ {{close}}")

longStopAlert  = enableStrategy and longStopHit
shortStopAlert = enableStrategy and shortStopHit
alertcondition(longStopAlert,  title="Long Stop Hit",  message="Long stop hit on {{ticker}} {{interval}} @ {{close}}")
alertcondition(shortStopAlert, title="Short Stop Hit", message="Short stop hit on {{ticker}} {{interval}} @ {{close}}")

// =========================
// ==== Backtest-kit Outputs
// =========================
pineSignal = startLongTrade ? 1 : startShortTrade ? -1 : 0
pineStopLoss = simPos != 0 and not na(activeStop) ? activeStop : pineSignal == 1 ? close - slAtrMult * atrNow : pineSignal == -1 ? close + slAtrMult * atrNow : close
pineTakeProfit = simPos != 0 and not na(activeTakeProfit) ? activeTakeProfit : pineSignal == 1 ? close + tpAtrMult * atrNow : pineSignal == -1 ? close - tpAtrMult * atrNow : close
pineEstimatedTime = 240

// Optimizer-ready numeric exports
trendXLongPass = not useTrendXConf or trendx == 1
trendXShortPass = not useTrendXConf or trendx == -1

featurePrediction = prediction
featureTrendX = trendx
featureKernelEstimate = kernelEstimate
featureKernelBullish = isBullish ? 1 : 0
featureKernelBearish = isBearish ? 1 : 0
featureRawLongPrediction = prediction > 0 ? 1 : 0
featureRawShortPrediction = prediction < 0 ? 1 : 0
featureFilterVolatility = filter.volatility ? 1 : 0
featureFilterRegime = filter.regime ? 1 : 0
featureFilterAdx = filter.adx ? 1 : 0
featureFilterAll = filter_all ? 1 : 0
featureLongPostFilter = prediction > 0 and filter_all ? 1 : 0
featureShortPostFilter = prediction < 0 and filter_all ? 1 : 0
featureSignalLong = signal == direction.long ? 1 : 0
featureSignalShort = signal == direction.short ? 1 : 0
featureNewBuySignal = isNewBuySignal ? 1 : 0
featureNewSellSignal = isNewSellSignal ? 1 : 0
featureBaseStartLong = baseStartLong ? 1 : 0
featureBaseStartShort = baseStartShort ? 1 : 0
featureTrendXLongPass = trendXLongPass ? 1 : 0
featureTrendXShortPass = trendXShortPass ? 1 : 0
featurePredLongStrengthPass = predLongStrengthPass ? 1 : 0
featurePredShortStrengthPass = predShortStrengthPass ? 1 : 0
featureCooldownOk = cooldownOk ? 1 : 0
featureAtrFlipBull = fusionAtrFlipBull ? 1 : 0
featureAtrFlipBear = fusionAtrFlipBear ? 1 : 0
featureEmaCrossBull = fusionEmaCrossBull ? 1 : 0
featureEmaCrossBear = fusionEmaCrossBear ? 1 : 0
featureEngulfingBull = fusionEngulfingBull ? 1 : 0
featureEngulfingBear = fusionEngulfingBear ? 1 : 0
featureLongFusionScore = longFusionScore
featureShortFusionScore = shortFusionScore
featureLongFusionBonus = longFusionBonus
featureShortFusionBonus = shortFusionBonus
featureLongFusionPenalty = longFusionPenalty
featureShortFusionPenalty = shortFusionPenalty
featureLongFusionV4Residual = longFusionV4Residual
featureShortFusionV4Residual = shortFusionV4Residual
featureFusionV4Active = fusionV4RangeActive ? 1 : 0
featureEffectiveLongStrength = effectiveLongStrength
featureEffectiveShortStrength = effectiveShortStrength
featureRequiredLongStrength = requiredLongStrength
featureRequiredShortStrength = requiredShortStrength
featureLongFusionPass = longFusionPass ? 1 : 0
featureShortFusionPass = shortFusionPass ? 1 : 0
featureSupertrendBull = supertrendBull ? 1 : 0
featureSupertrendBear = supertrendBear ? 1 : 0
featureSupertrendPassLong = supertrendPassLong ? 1 : 0
featureSupertrendPassShort = supertrendPassShort ? 1 : 0
featureAvwapBullBias = avwapBullBias ? 1 : 0
featureAvwapBearBias = avwapBearBias ? 1 : 0
featureChannelCompressionScore = channelCompressionScore
featureContextLongQualify = contextLongQualify ? 1 : 0
featureContextShortQualify = contextShortQualify ? 1 : 0
featureLongContextCaution = contextLongCaution ? 1 : 0
featureShortContextCaution = contextShortCaution ? 1 : 0
featureSqueezeState = squeezeOn ? 1 : 0
featureSqueezeReleaseBull = squeezeReleaseBull ? 1 : 0
featureSqueezeReleaseBear = squeezeReleaseBear ? 1 : 0
featureSqueezeLongBoost = squeezeLongBoost
featureSqueezeShortBoost = squeezeShortBoost
featureSqueezeLongCaution = squeezeLongCaution ? 1 : 0
featureSqueezeShortCaution = squeezeShortCaution ? 1 : 0
featureCompressionState = (featureSqueezeState > 0 or featureChannelCompressionScore >= 0.6) ? 1 : 0
featureExpansionState = (featureSqueezeReleaseBull > 0 or featureSqueezeReleaseBear > 0 or featureSqueezeLongBoost > 0 or featureSqueezeShortBoost > 0) ? 1 : 0
featureTrendStrengthState = ((trendx != 0 ? 1 : 0) + (featureTrendXLongPass ? 1 : 0) + (featureTrendXShortPass ? 1 : 0) + (featureSupertrendBull ? 1 : 0) + (featureSupertrendBear ? 1 : 0)) > 0 ? 1 : 0
featureDivBullConfirmed = divBullConfirmed ? 1 : 0
featureDivBearConfirmed = divBearConfirmed ? 1 : 0
featureDivBullFresh = divBullFresh ? 1 : 0
featureDivBearFresh = divBearFresh ? 1 : 0
featureDivLongBoost = divLongBoost
featureDivShortBoost = divShortBoost
featureDivLongPenalty = divLongPenalty
featureDivShortPenalty = divShortPenalty
featureDivLongCaution = divLongCaution ? 1 : 0
featureDivShortCaution = divShortCaution ? 1 : 0
featureCautionDensity = (featureLongContextCaution + featureShortContextCaution + featureSqueezeLongCaution + featureSqueezeShortCaution + featureDivLongCaution + featureDivShortCaution) / 6.0
featureLongEarlyExitAllowed = contextAllowLongEarlyExit ? 1 : 0
featureShortEarlyExitAllowed = contextAllowShortEarlyExit ? 1 : 0
featureFailedFollowThroughTighten = (longFailedFollowThroughTighten or shortFailedFollowThroughTighten) ? 1 : 0
featureTimeStopTriggered = (longTimeStopExit or shortTimeStopExit) ? 1 : 0
featureContextCautionTightened = (longContextCautionTighten or shortContextCautionTighten) ? 1 : 0
featurePartialDeriskTriggered = (longPartialDeriskTriggered or shortPartialDeriskTriggered) ? 1 : 0
featurePostEntrySqueezeCollapseTighten = (longPostEntrySqueezeCollapseTighten or shortPostEntrySqueezeCollapseTighten) ? 1 : 0
featureAdverseDivergenceTighten = (longAdverseDivergenceTighten or shortAdverseDivergenceTighten) ? 1 : 0
featureTrailAtrMultInForce = simPos == 1 ? longTrailAtrMultInForce : simPos == -1 ? shortTrailAtrMultInForce : trailAtrMult
featureLiveContextScoreDelta = simPos == 1 and not na(simEntryContextScore) ? exitStateLongContextScore - simEntryContextScore : simPos == -1 and not na(simEntryContextScore) ? exitStateShortContextScore - simEntryContextScore : 0.0
featureLongTrailTightened = simPos == 1 and longTrailAtrMultInForce < trailAtrMult ? 1 : 0
featureShortTrailTightened = simPos == -1 and shortTrailAtrMultInForce < trailAtrMult ? 1 : 0
featureBlockLongTrendX = baseStartLong and not trendXLongPass ? 1 : 0
featureBlockShortTrendX = baseStartShort and not trendXShortPass ? 1 : 0
featureBlockLongPred = baseStartLong and trendXLongPass and not predLongStrengthPass ? 1 : 0
featureBlockShortPred = baseStartShort and trendXShortPass and not predShortStrengthPass ? 1 : 0
featureBlockLongCooldown = baseStartLong and trendXLongPass and predLongStrengthPass and not cooldownOk ? 1 : 0
featureBlockShortCooldown = baseStartShort and trendXShortPass and predShortStrengthPass and not cooldownOk ? 1 : 0
featureBlockLongFusion = baseStartLong and trendXLongPass and predLongStrengthPass and cooldownOk and not longFusionPass ? 1 : 0
featureBlockShortFusion = baseStartShort and trendXShortPass and predShortStrengthPass and cooldownOk and not shortFusionPass ? 1 : 0
featureBlockLongSupertrend = baseStartLong and trendXLongPass and predLongStrengthPass and cooldownOk and longFusionPass and not supertrendPassLong ? 1 : 0
featureBlockShortSupertrend = baseStartShort and trendXShortPass and predShortStrengthPass and cooldownOk and shortFusionPass and not supertrendPassShort ? 1 : 0
featureStartLong = startLongTrade ? 1 : 0
featureStartShort = startShortTrade ? 1 : 0
featureEndLong = endLongTrade ? 1 : 0
featureEndShort = endShortTrade ? 1 : 0
featureTrailActive = ((longTrailActive and simPos == 1) or (shortTrailActive and simPos == -1)) ? 1 : 0
featureTrailStopDistance = simPos == 1 and not na(activeStop) ? close - activeStop : simPos == -1 and not na(activeStop) ? activeStop - close : 0
featureTrailMoved = not na(simTrailStop) ? 1 : 0
featureTrailExitLong = longTrailExit ? 1 : 0
featureTrailExitShort = shortTrailExit ? 1 : 0
featureSimPos = simPos

