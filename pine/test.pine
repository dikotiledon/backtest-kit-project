
//@version=5
indicator('My Script', 'My Script', overlay=true, format=format.price, precision=4, max_labels_count=500)
import jdehorty/MLExtensions/3 as ml
import jdehorty/KernelFunctions/2 as kernels

Periods = 10
srcx = hlc3
Multiplier1 = 0.8
Multiplier2 = 1.6
changeATR = true
showsignals = true
highlighting = true
atr2 = ta.sma(ta.atr(1), Periods)
atr = changeATR ? ta.atr(Periods) : atr2
// Set up the initial direction buy/sell signals
up = srcx - Multiplier1 * atr
up1 = nz(up[1], up)
up := close[1] > up1 ? math.max(up, up1) : up
dn = srcx + Multiplier1 * atr
dn1 = nz(dn[1], dn)
dn := close[1] < dn1 ? math.min(dn, dn1) : dn
trend = 1
trend := nz(trend[1], trend)
trend := trend == -1 and close > dn1 ? 1 : trend == 1 and close < up1 ? -1 : trend
upPlot = plot(trend == 1 ? up : na, title='Up Trend', style=plot.style_linebr, linewidth=1, color=color.new(color.green, 0))
buySignal = trend == 1 and trend[1] == -1
plotshape(buySignal ? up : na, title='UpTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(color.green, 0))
plotshape(buySignal and showsignals ? up : na, title='Buy', text='Buy', location=location.absolute, style=shape.labelup, size=size.tiny, color=color.new(color.green, 0), textcolor=color.new(color.white, 0))
dnPlot = plot(trend == 1 ? na : dn, title='Down Trend', style=plot.style_linebr, linewidth=1, color=color.new(color.red, 0))
sellSignal = trend == -1 and trend[1] == 1
plotshape(sellSignal ? dn : na, title='DownTrend Begins', location=location.absolute, style=shape.circle, size=size.tiny, color=color.new(color.red, 0))
plotshape(sellSignal and showsignals ? dn : na, title='Sell', text='Sell', location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.new(color.red, 0), textcolor=color.new(color.white, 0))

// Set up the confirmation buy/sell signals
upx = srcx - Multiplier2 * atr
upx1 = nz(upx[1], upx)
upx := close[1] > upx1 ? math.max(upx, upx1) : upx
dnx = srcx + Multiplier2 * atr
dnx1 = nz(dnx[1], dnx)
dnx := close[1] < dnx1 ? math.min(dnx, dnx1) : dnx
trendx = 1
trendx := nz(trendx[1], trendx)
trendx := trendx == -1 and close > dnx1 ? 1 : trendx == 1 and close < upx1 ? -1 : trendx
upxPlot = plot(trendx == 1 ? upx : na, title='Up Trend', style=plot.style_linebr, linewidth=2, color=color.rgb(0, 255, 0))
buySignalx = trendx == 1 and trendx[1] == -1
plotshape(buySignalx ? upx : na, title='UpTrend Confirmed', location=location.absolute, style=shape.circle, size=size.tiny, color=color.rgb(0, 255, 0, 0))
plotshape(buySignalx and showsignals ? upx : na, title='Buy', text='Buy', location=location.absolute, style=shape.labelup, size=size.tiny, color=color.rgb(0, 255, 0,0), textcolor=color.new(color.black, 0))
dnxPlot = plot(trendx == 1 ? na : dnx, title='Down Trend', style=plot.style_linebr, linewidth=2, color=color.rgb(255, 0, 0))
sellSignalx = trendx == -1 and trendx[1] == 1
plotshape(sellSignalx ? dnx : na, title='DownTrend Confirmed', location=location.absolute, style=shape.circle, size=size.tiny, color=color.rgb(255, 0, 0, 0))
plotshape(sellSignalx and showsignals ? dnx : na, title='Sell', text='Sell', location=location.absolute, style=shape.labeldown, size=size.tiny, color=color.rgb(255, 0, 0,0), textcolor=color.new(color.white, 0))

per=input(21, title='calculate for last ## bars')
hl=ta.highest(high,per) //High Line (Border)
ll=ta.lowest(low,per)   //Low Line  (Border)
dist=hl-ll          //range of the channel    
hf=hl-dist*0.236    //Highest Fibonacci line
cfh=hl-dist*0.382    //Center High Fibonacci line
cfl=hl-dist*0.618    //Center Low Fibonacci line
lf=hl-dist*0.764     //Lowest Fibonacci line
fill(plot(hl, title="high border"), plot(hf), color = color.new(color.lime,90)) //up trend zone
fill(plot(ll, title="low border"), plot(lf), color=color.new(color.red,90))   //down trend zone

shortest = ta.ema(close, 20)
short = ta.ema(close, 50)
longer = ta.ema(close, 100)
longest = ta.ema(close, 200)

len2 = 50
src2 = input(close, title="Source")
out2 = ta.sma(src2, len2)
len1 = 200
src1 = input(close, title="Source")
out1 = ta.sma(src1, len1)


type Settings
    float source
    int neighborsCount
    int maxBarsBack
    int featureCount
    int colorCompression
    bool showExits
    bool useDynamicExits

type Label
    int long
    int short
    int neutral

type FeatureArrays
    array<float> f1
    array<float> f2
    array<float> f3
    array<float> f4
    array<float> f5

type FeatureSeries
    float f1
    float f2
    float f3
    float f4
    float f5

type MLModel
    int firstBarIndex
    array<int> trainingLabels
    int loopSize
    float lastDistance
    array<float> distancesArray
    array<int> predictionsArray
    int prediction

type FilterSettings 
    bool useVolatilityFilter
    bool useRegimeFilter
    bool useAdxFilter
    float regimeThreshold
    int adxThreshold

type Filter
    bool volatility
    bool regime
    bool adx 

// ==========================
// ==== Helper Functions ====
// ==========================

series_from(feature_string, _close, _high, _low, _hlc3, f_paramA, f_paramB) =>
    switch feature_string
        "RSI" => ml.n_rsi(_close, f_paramA, f_paramB)
        "WT" => ml.n_wt(_hlc3, f_paramA, f_paramB)
        "CCI" => ml.n_cci(_close, f_paramA, f_paramB)
        "ADX" => ml.n_adx(_high, _low, _close, f_paramA)

get_lorentzian_distance(int i, int featureCount, FeatureSeries featureSeries, FeatureArrays featureArrays) =>
    d1 = math.log(1 + math.abs(featureSeries.f1 - array.get(featureArrays.f1, i)))
    d2 = math.log(1 + math.abs(featureSeries.f2 - array.get(featureArrays.f2, i)))
    d3 = math.log(1 + math.abs(featureSeries.f3 - array.get(featureArrays.f3, i)))
    d4 = math.log(1 + math.abs(featureSeries.f4 - array.get(featureArrays.f4, i)))
    d5 = math.log(1 + math.abs(featureSeries.f5 - array.get(featureArrays.f5, i)))
    featureCount == 5 ? d1 + d2 + d3 + d4 + d5 :
     featureCount == 4 ? d1 + d2 + d3 + d4 :
     featureCount == 3 ? d1 + d2 + d3 :
     d1 + d2

// ================  
// ==== Inputs ==== 
// ================ 

// Settings Object: General User-Defined Inputs
Settings settings = Settings.new(input.source(title='Source', defval=close, group="General Settings", tooltip="Source of the input data"), input.int(title='Neighbors Count', defval=8, group="General Settings", minval=1, maxval=100, step=1, tooltip="Number of neighbors to consider"), input.int(title="Max Bars Back", defval=2000, group="General Settings"), input.int(title="Feature Count", defval=5, group="Feature Engineering", minval=2, maxval=5, tooltip="Number of features to use for ML predictions."), input.int(title="Color Compression", defval=1, group="General Settings", minval=1, maxval=10, tooltip="Compression factor for adjusting the intensity of the color scale."), input.bool(title="Show Default Exits", defval=false, group="General Settings", tooltip="Default exits occur exactly 4 bars after an entry signal. This corresponds to the predefined length of a trade during the model's training process.", inline="exits"), input.bool(title="Use Dynamic Exits", defval=false, group="General Settings", tooltip="Dynamic exits attempt to let profits ride by dynamically adjusting the exit threshold based on kernel regression logic.", inline="exits"))
   
// Trade Stats Settings
// Note: The trade stats section is NOT intended to be used as a replacement for proper backtesting. It is intended to be used for calibration purposes only
showTradeStats = input.bool(false, title="Show Performance Panel", group="Performance")
useWorstCase = input.bool(false, title="Use Worst-Case Fills", group="Performance")

// Settings object for user-defined settings
FilterSettings filterSettings = FilterSettings.new(input.bool(title="Use Volatility Filter", defval=false, tooltip="Whether to use the volatility filter.", group="Filters"), input.bool(title="Use Regime Filter", defval=false, group="Filters", inline="regime"), input.bool(title="Use ADX Filter", defval=true, group="Filters", inline="adx"), input.float(title="Threshold", defval=-0.1, minval=-10, maxval=10, step=0.1, tooltip="Whether to use the trend detection filter. Threshold for detecting Trending/Ranging markets.", group="Filters", inline="regime"), input.int(title="Threshold", defval=20, minval=0, maxval=100, step=1, tooltip="Whether to use the ADX filter. Threshold for detecting Trending/Ranging markets.", group="Filters", inline="adx"))

// Filter object for filtering the ML predictions
Filter filter = Filter.new(
   ml.filter_volatility(1, 10, filterSettings.useVolatilityFilter), 
   ml.regime_filter(ohlc4, filterSettings.regimeThreshold, filterSettings.useRegimeFilter),
   ml.filter_adx(settings.source, 14, filterSettings.adxThreshold, filterSettings.useAdxFilter)
  )

// Feature Variables: User-Defined Inputs for calculating Feature Series. 
f1_string = "RSI"
f1_paramA = 14
f1_paramB = 1
f2_string = "WT"
f2_paramA = 10
f2_paramB = 11
f3_string = "CCI"
f3_paramA = 20
f3_paramB = 1
f4_string = "ADX"
f4_paramA = 29
f4_paramB = 2
f5_string = "RSI"
f5_paramA = 9
f5_paramB = 1

// FeatureSeries Object: Calculated Feature Series based on Feature Variables
featureSeries = FeatureSeries.new(
   series_from(f1_string, close, high, low, hlc3, f1_paramA, f1_paramB), // f1
   series_from(f2_string, close, high, low, hlc3, f2_paramA, f2_paramB), // f2 
   series_from(f3_string, close, high, low, hlc3, f3_paramA, f3_paramB), // f3
   series_from(f4_string, close, high, low, hlc3, f4_paramA, f4_paramB), // f4
   series_from(f5_string, close, high, low, hlc3, f5_paramA, f5_paramB)  // f5
 )

// FeatureArrays Variables: Storage of Feature Series as Feature Arrays Optimized for ML
// Note: These arrays cannot be dynamically created within the FeatureArrays Object Initialization and thus must be set-up in advance.
var f1Array = array.new_float()
var f2Array = array.new_float()
var f3Array = array.new_float()
var f4Array = array.new_float()
var f5Array = array.new_float()
array.push(f1Array, featureSeries.f1)
array.push(f2Array, featureSeries.f2)
array.push(f3Array, featureSeries.f3)
array.push(f4Array, featureSeries.f4)
array.push(f5Array, featureSeries.f5)

// FeatureArrays Object: Storage of the calculated FeatureArrays into a single object
featureArrays = FeatureArrays.new(
  f1Array, // f1
  f2Array, // f2
  f3Array, // f3
  f4Array, // f4
  f5Array  // f5
 )

// Label Object: Used for classifying historical data as training data for the ML Model
Label direction = Label.new(
   long=1, 
   short=-1, 
   neutral=0
  )

// Derived from General Settings
maxBarsBackIndex = last_bar_index >= settings.maxBarsBack ? last_bar_index - settings.maxBarsBack : 0

// EMA Settings 
useEmaFilter = input.bool(title="Use EMA Filter", defval=false, group="Filters", inline="ema")
emaPeriod = input.int(title="Period", defval=200, minval=1, step=1, group="Filters", inline="ema", tooltip="The period of the EMA used for the EMA Filter.")
isEmaUptrend = useEmaFilter ? close > ta.ema(close, emaPeriod) : true
isEmaDowntrend = useEmaFilter ? close < ta.ema(close, emaPeriod) : true
useSmaFilter = input.bool(title="Use SMA Filter", defval=false, group="Filters", inline="sma")
smaPeriod = input.int(title="Period", defval=200, minval=1, step=1, group="Filters", inline="sma", tooltip="The period of the SMA used for the SMA Filter.")
isSmaUptrend = useSmaFilter ? close > ta.sma(close, smaPeriod) : true
isSmaDowntrend = useSmaFilter ? close < ta.sma(close, smaPeriod) : true

// Nadaraya-Watson Kernel Regression Settings
useKernelFilter = true
showKernelEstimate = true
useKernelSmoothing = false
h = input.int(8, 'Lookback Window', minval=3, tooltip='The number of bars used for the estimation. This is a sliding value that represents the most recent historical bars. Recommended range: 3-50', group="Kernel Settings", inline="kernel")
r = input.float(8., 'Relative Weighting', step=0.25, tooltip='Relative weighting of time frames. As this value approaches zero, the longer time frames will exert more influence on the estimation. As this value approaches infinity, the behavior of the Rational Quadratic Kernel will become identical to the Gaussian kernel. Recommended range: 0.25-25', group="Kernel Settings", inline="kernel")
x = input.int(25, "Regression Level", tooltip='Bar index on which to start regression. Controls how tightly fit the kernel estimate is to the data. Smaller values are a tighter fit. Larger values are a looser fit. Recommended range: 2-25', group="Kernel Settings", inline="kernel")
lag = input.int(2, "Lag", tooltip="Lag for crossover detection. Lower values result in earlier crossovers. Recommended range: 1-2", inline='1', group='Kernel Settings')

// Display Settings
showBarColors = input.bool(false, "Show Bar Colors", group="Display")
showBarPredictions = input.bool(false, "Show Bar Predictions", group="Display")
useAtrOffset = true
barPredictionsOffset = 0

// =================================
// ==== Next Bar Classification ====
// =================================

// This model specializes specifically in predicting the direction of price action over the course of the next 4 bars. 
// To avoid complications with the ML model, this value is hardcoded to 4 bars but support for other training lengths may be added in the future.
src = settings.source
y_train_series = src[4] < src[0] ? direction.short : src[4] > src[0] ? direction.long : direction.neutral
var y_train_array = array.new_int(0)

// Variables used for ML Logic
var predictions = array.new_float(0)
var prediction = 0.
var signal = direction.neutral
var distances = array.new_float(0)

array.push(y_train_array, y_train_series)

lastDistance = -1.0
size = math.min(settings.maxBarsBack-1, array.size(y_train_array)-1)
// Apply a hard cap to scanning for performance
cap = input.int(400, "Internal: ML Scan Cap", minval=50, maxval=2000, step=50, group="Performance")
// Control sampling density: evaluate every N bars (suggest multiples of label horizon=4)
sampleStride = input.int(4, "Sampling Stride (bars)", minval=1, maxval=32, group="Performance")
sizeLoop = math.min(math.min(settings.maxBarsBack-1, size), cap)

if bar_index >= maxBarsBackIndex
    for i = 0 to sizeLoop
        d = get_lorentzian_distance(i, settings.featureCount, featureSeries, featureArrays)
        // Sample every N bars (user-controlled) to balance speed and accuracy
        if d >= lastDistance and (i % sampleStride == 0)
            lastDistance := d
            array.push(distances, d)
            array.push(predictions, math.round(array.get(y_train_array, i)))
            if array.size(predictions) > settings.neighborsCount
                lastDistance := array.get(distances, math.round(settings.neighborsCount*3/4))
                array.shift(distances)
                array.shift(predictions)
    prediction := array.sum(predictions)

// ============================
// ==== Prediction Filters ====
// ============================

// User Defined Filters: Used for adjusting the frequency of the ML Model's predictions
filter_all = filter.volatility and filter.regime and filter.adx

// Filtered Signal: The model's prediction of future price movement direction with user-defined filters applied
signal := prediction > 0 and filter_all ? direction.long : prediction < 0 and filter_all ? direction.short : nz(signal[1])

// Bar-Count Filters: Represents strict filters based on a pre-defined holding period of 4 bars
var int barsHeld = 0
barsHeld := (signal != signal[1]) ? 0 : (barsHeld + 1)
isHeldFourBars = barsHeld == 4
isHeldLessThanFourBars = 0 < barsHeld and barsHeld < 4

// Fractal Filters: Derived from relative appearances of signals in a given time series fractal/segment with a default length of 4 bars
isDifferentSignalType = (signal != signal[1])
isEarlySignalFlip = (signal != signal[1]) and ((signal[1] != signal[2]) or (signal[2] != signal[3]) or (signal[3] != signal[4]))
isBuySignal = signal == direction.long and isEmaUptrend and isSmaUptrend
isSellSignal = signal == direction.short and isEmaDowntrend and isSmaDowntrend
isLastSignalBuy = signal[4] == direction.long and isEmaUptrend[4] and isSmaUptrend[4]
isLastSignalSell = signal[4] == direction.short and isEmaDowntrend[4] and isSmaDowntrend[4]
isNewBuySignal = isBuySignal and isDifferentSignalType
isNewSellSignal = isSellSignal and isDifferentSignalType

// Kernel Regression Filters: Filters based on Nadaraya-Watson Kernel Regression using the Rational Quadratic Kernel
// For more information on this technique refer to my other open source indicator located here: 
// https://www.tradingview.com/script/AWNvbPRM-Nadaraya-Watson-Rational-Quadratic-Kernel-Non-Repainting/

yhat1 = kernels.rationalQuadratic(settings.source, h, r, x)
yhat2 = kernels.gaussian(settings.source, h-lag, x)
kernelEstimate = yhat1
// Kernel Rates of Change
bool wasBearishRate = yhat1[2] > yhat1[1]
bool wasBullishRate = yhat1[2] < yhat1[1]
bool isBearishRate = yhat1[1] > yhat1
bool isBullishRate = yhat1[1] < yhat1
isBearishChange = isBearishRate and wasBullishRate
isBullishChange = isBullishRate and wasBearishRate
// Kernel Crossovers
bool isBullishCrossAlert = ta.crossover(yhat2, yhat1)
bool isBearishCrossAlert = ta.crossunder(yhat2, yhat1) 
bool isBullishSmooth = yhat2 >= yhat1
bool isBearishSmooth = yhat2 <= yhat1
// Kernel Colors
color colorByCross = isBullishSmooth ? color.new(#009988, 1) : color.new(#CC3311, 1)
color colorByRate = isBullishRate ? color.new(#009988, 1) : color.new(#CC3311, 1)
color plotColor = showKernelEstimate ? (useKernelSmoothing ? colorByCross : colorByRate) : color.new(#000000, 100)
plot(kernelEstimate, color=plotColor, linewidth=2, title="Kernel Regression Estimate")
// Alert Variables
bool alertBullish = useKernelSmoothing ? isBullishCrossAlert : isBullishChange
bool alertBearish = useKernelSmoothing ? isBearishCrossAlert : isBearishChange
// Bullish and Bearish Filters based on Kernel
isBullish = useKernelFilter ? (useKernelSmoothing ? isBullishSmooth : isBullishRate) : true
isBearish = useKernelFilter ? (useKernelSmoothing ? isBearishSmooth : isBearishRate) : true

// ===========================
// ==== Entries and Exits ====
// ===========================

// Entry Conditions: Booleans for ML Model Position Entries
baseStartLong = isNewBuySignal and isBullish and isEmaUptrend and isSmaUptrend
baseStartShort = isNewSellSignal and isBearish and isEmaDowntrend and isSmaDowntrend

// Edge controls to improve trade quality
// Default profile: Fusion V4 hardened preset from locked 10k-bar XRPUSDT 15m benchmark (2026-04-21)
useTrendXConf = input.bool(true,  title="Require Confirmation Trend (x)", group="Edge Controls")
minPredSum    = input.float(2,  title="Min Prediction Sum (strength)", minval=0.0, step=0.5, group="Edge Controls")
minBarsBetween = input.int(2, title="Cooldown Bars Between Entries", minval=0, group="Edge Controls")
useSignalFusion = input.bool(true, title="Use Signal Fusion", group="Edge Controls")
minFusionScore = input.int(1, title="Min Fusion Score", minval=0, maxval=4, group="Edge Controls")
useAtrFlipConfirm = input.bool(true, title="Use ATR Flip Confirm", group="Signal Fusion")
use3LineConfirm = input.bool(false, title="Use 3 Line Strike Confirm", group="Signal Fusion")
useEngulfingConfirm = input.bool(true, title="Use Engulfing Confirm", group="Signal Fusion")
useEmaCrossConfirm = input.bool(false, title="Use EMA Cross Confirm", group="Signal Fusion")
useFusionV2 = input.bool(false, title="Use Fusion V2 Soft Mode", group="Signal Fusion V2")
fusionBonusPerSignal = input.float(0.25, title="Fusion Bonus Per Signal", minval=0.0, step=0.05, group="Signal Fusion V2")
fusionMaxBonus = input.float(0.50, title="Fusion Max Bonus", minval=0.0, step=0.05, group="Signal Fusion V2")
useFusionV3 = input.bool(false, title="Use Fusion V3 Threshold Shaping", group="Signal Fusion V3")
fusionPenaltyPerMissing = input.float(0.25, title="Fusion Penalty Per Missing Signal", minval=0.0, step=0.05, group="Signal Fusion V3")
useFusionV4 = input.bool(true, title="Use Fusion V4 Residual Layer", group="Signal Fusion V4")
fusionV4MinAbsPrediction = input.float(2, title="Fusion V4 Min |Prediction|", minval=0.0, step=0.5, group="Signal Fusion V4")
fusionV4MaxAbsPrediction = input.float(4, title="Fusion V4 Max |Prediction|", minval=0.0, step=0.5, group="Signal Fusion V4")
fusionV4LongAtrWeight = input.float(-0.25, title="Fusion V4 Long ATR Weight", step=0.05, group="Signal Fusion V4")
fusionV4LongEngulfWeight = input.float(-0.25, title="Fusion V4 Long Engulf Weight", step=0.05, group="Signal Fusion V4")
fusionV4LongEmaWeight = input.float(0, title="Fusion V4 Long EMA Weight", step=0.05, group="Signal Fusion V4")
fusionV4ShortAtrWeight = input.float(-0.5, title="Fusion V4 Short ATR Weight", step=0.05, group="Signal Fusion V4")
fusionV4ShortEngulfWeight = input.float(-0.1, title="Fusion V4 Short Engulf Weight", step=0.05, group="Signal Fusion V4")
fusionV4ShortEmaWeight = input.float(0, title="Fusion V4 Short EMA Weight", step=0.05, group="Signal Fusion V4")
useSupertrendFilter = input.bool(true, title="Use Supertrend Filter", group="Phase 3: Supertrend")
useSupertrendEntryConfirm = input.bool(false, title="Require Supertrend Flip Confirm", group="Phase 3: Supertrend")
supertrendAtrLen = input.int(10, title="Supertrend ATR Length", minval=1, group="Phase 3: Supertrend")
supertrendFactor = input.float(1.5, title="Supertrend Factor", minval=0.1, step=0.1, group="Phase 3: Supertrend")

useAvwapContext = input.bool(false, title="Use AVWAP Context", group="Phase 3: AVWAP Context")
avwapSwingPeriod = input.int(50, title="AVWAP Swing Period", minval=2, group="Phase 3: AVWAP Context")
avwapReclaimFreshBars = input.int(6, title="AVWAP Reclaim Fresh Bars", minval=1, group="Phase 3: AVWAP Context")
avwapMaxDistanceAtr = input.float(1.0, title="AVWAP Max Distance ATR", minval=0.1, step=0.1, group="Phase 3: AVWAP Context")
avwapMaxAnchorAge = input.int(100, title="AVWAP Max Anchor Age", minval=1, group="Phase 3: AVWAP Context")
avwapRequireReclaimForEntry = input.bool(false, title="Require AVWAP Reclaim For Entry", group="Phase 3: AVWAP Context")

useChannelContext = input.bool(false, title="Use Breakout Context", group="Phase 3: Breakout Context")
channelDetectLength = input.int(18, title="Channel Detect Length", minval=2, group="Phase 3: Breakout Context")
channelCompressionThreshold = input.float(0.35, title="Channel Compression Threshold", minval=0.0, step=0.05, group="Phase 3: Breakout Context")
channelBreakoutFreshBars = input.int(4, title="Channel Breakout Fresh Bars", minval=1, group="Phase 3: Breakout Context")
channelEnableRetest = input.bool(false, title="Enable Channel Retest", group="Phase 3: Breakout Context")
channelRetestFreshBars = input.int(6, title="Channel Retest Fresh Bars", minval=1, group="Phase 3: Breakout Context")
channelHostileBlocksEntry = input.bool(true, title="Channel Hostile Blocks Entry", group="Phase 3: Breakout Context")

useContextAggregator = input.bool(false, title="Use Context Aggregator", group="Phase 3: Context Aggregator")
contextStrictRequireChannel = input.bool(false, title="Strict Require Channel", group="Phase 3: Context Aggregator")
contextBoostAddsToStrength = input.bool(false, title="Context Boost Adds To Strength", group="Phase 3: Context Aggregator")
contextBoostValue = input.float(0.25, title="Context Boost Value", step=0.05, group="Phase 3: Context Aggregator")
contextHostileBlocksEntry = input.bool(true, title="Context Hostile Blocks Entry", group="Phase 3: Context Aggregator")

useContextExitShaping = input.bool(false, title="Use Context Exit Shaping", group="Phase 3: Context Exit Shaping")
contextTightenTrailOnCaution = input.bool(false, title="Tighten Trail On Caution", group="Phase 3: Context Exit Shaping")
contextTrailTightenFactor = input.float(0.75, title="Context Trail Tighten Factor", minval=0.1, maxval=1.0, step=0.05, group="Phase 3: Context Exit Shaping")
contextAllowEarlySignalExit = input.bool(false, title="Allow Early Signal Exit", group="Phase 3: Context Exit Shaping")

fusion3LineBull = close[3] < open[3] and close[2] < open[2] and close[1] < open[1] and close > open[1]
fusion3LineBear = close[3] > open[3] and close[2] > open[2] and close[1] > open[1] and close < open[1]
fusionEngulfingBull = open <= close[1] and open < open[1] and close > open[1]
fusionEngulfingBear = open >= close[1] and open > open[1] and close < open[1]
fusionEmaSlow = ta.ema(close, 62)
fusionEmaFast = ta.ema(close, 38)
fusionEmaCrossBull = fusionEmaFast > fusionEmaSlow and close[1] < fusionEmaFast and close > fusionEmaFast
fusionEmaCrossBear = fusionEmaFast < fusionEmaSlow and close[1] > fusionEmaFast and close < fusionEmaFast
fusionAtrFlipBull = buySignal
fusionAtrFlipBear = sellSignal
fusionEnabledCount = (useAtrFlipConfirm ? 1 : 0) + (use3LineConfirm ? 1 : 0) + (useEngulfingConfirm ? 1 : 0) + (useEmaCrossConfirm ? 1 : 0)
longFusionScore = (useAtrFlipConfirm and fusionAtrFlipBull ? 1 : 0) + (use3LineConfirm and fusion3LineBull ? 1 : 0) + (useEngulfingConfirm and fusionEngulfingBull ? 1 : 0) + (useEmaCrossConfirm and fusionEmaCrossBull ? 1 : 0)
shortFusionScore = (useAtrFlipConfirm and fusionAtrFlipBear ? 1 : 0) + (use3LineConfirm and fusion3LineBear ? 1 : 0) + (useEngulfingConfirm and fusionEngulfingBear ? 1 : 0) + (useEmaCrossConfirm and fusionEmaCrossBear ? 1 : 0)
longFusionBonus = useSignalFusion and (useFusionV2 or useFusionV3) ? math.min(fusionMaxBonus, longFusionScore * fusionBonusPerSignal) : 0.0
shortFusionBonus = useSignalFusion and (useFusionV2 or useFusionV3) ? math.min(fusionMaxBonus, shortFusionScore * fusionBonusPerSignal) : 0.0
longFusionPenalty = useSignalFusion and useFusionV3 ? math.max(0.0, fusionEnabledCount - longFusionScore) * fusionPenaltyPerMissing : 0.0
shortFusionPenalty = useSignalFusion and useFusionV3 ? math.max(0.0, fusionEnabledCount - shortFusionScore) * fusionPenaltyPerMissing : 0.0
fusionV4RangeActive = useSignalFusion and useFusionV4 and math.abs(prediction) >= fusionV4MinAbsPrediction and math.abs(prediction) <= fusionV4MaxAbsPrediction
longFusionV4Residual = fusionV4RangeActive ? (useAtrFlipConfirm and fusionAtrFlipBull ? fusionV4LongAtrWeight : 0.0) + (useEngulfingConfirm and fusionEngulfingBull ? fusionV4LongEngulfWeight : 0.0) + (useEmaCrossConfirm and fusionEmaCrossBull ? fusionV4LongEmaWeight : 0.0) : 0.0
shortFusionV4Residual = fusionV4RangeActive ? (useAtrFlipConfirm and fusionAtrFlipBear ? fusionV4ShortAtrWeight : 0.0) + (useEngulfingConfirm and fusionEngulfingBear ? fusionV4ShortEngulfWeight : 0.0) + (useEmaCrossConfirm and fusionEmaCrossBear ? fusionV4ShortEmaWeight : 0.0) : 0.0
effectiveLongStrength = prediction + longFusionBonus - longFusionPenalty + longFusionV4Residual
effectiveShortStrength = -prediction + shortFusionBonus - shortFusionPenalty + shortFusionV4Residual
longFusionPass = (useFusionV2 or useFusionV3 or useFusionV4) ? true : (not useSignalFusion or minFusionScore <= 0 or fusionEnabledCount == 0 or longFusionScore >= minFusionScore)
shortFusionPass = (useFusionV2 or useFusionV3 or useFusionV4) ? true : (not useSignalFusion or minFusionScore <= 0 or fusionEnabledCount == 0 or shortFusionScore >= minFusionScore)

supertrendAtr = ta.atr(supertrendAtrLen)
supertrendUp = hl2 - supertrendFactor * supertrendAtr
supertrendUp1 = nz(supertrendUp[1], supertrendUp)
supertrendUp := close[1] > supertrendUp1 ? math.max(supertrendUp, supertrendUp1) : supertrendUp
supertrendDn = hl2 + supertrendFactor * supertrendAtr
supertrendDn1 = nz(supertrendDn[1], supertrendDn)
supertrendDn := close[1] < supertrendDn1 ? math.min(supertrendDn, supertrendDn1) : supertrendDn
supertrendTrend = 1
supertrendTrend := nz(supertrendTrend[1], supertrendTrend)
supertrendTrend := supertrendTrend == -1 and close > supertrendDn1 ? 1 : supertrendTrend == 1 and close < supertrendUp1 ? -1 : supertrendTrend
supertrendBull = supertrendTrend == 1
supertrendBear = supertrendTrend == -1
supertrendFlipBull = supertrendBull and supertrendTrend[1] == -1
supertrendFlipBear = supertrendBear and supertrendTrend[1] == 1
supertrendLine = supertrendBull ? supertrendUp : supertrendDn
supertrendPassLong = (not useSupertrendFilter or supertrendBull) and (not useSupertrendEntryConfirm or supertrendFlipBull)
supertrendPassShort = (not useSupertrendFilter or supertrendBear) and (not useSupertrendEntryConfirm or supertrendFlipBear)

contextAtr = ta.atr(14)
avwapBasis = ta.vwma(hlc3, avwapSwingPeriod)
avwapBullBias = close >= avwapBasis
avwapBearBias = close <= avwapBasis
avwapDistanceAtr = contextAtr == 0 ? 0.0 : math.abs(close - avwapBasis) / contextAtr
avwapLongReclaim = ta.barssince(ta.crossover(close, avwapBasis)) <= avwapReclaimFreshBars
avwapShortReclaim = ta.barssince(ta.crossunder(close, avwapBasis)) <= avwapReclaimFreshBars
avwapLongOk = not useAvwapContext or (avwapBullBias and avwapDistanceAtr <= avwapMaxDistanceAtr and (not avwapRequireReclaimForEntry or avwapLongReclaim))
avwapShortOk = not useAvwapContext or (avwapBearBias and avwapDistanceAtr <= avwapMaxDistanceAtr and (not avwapRequireReclaimForEntry or avwapShortReclaim))
channelUpper = ta.highest(high, channelDetectLength)
channelLower = ta.lowest(low, channelDetectLength)
channelWidth = math.max(channelUpper - channelLower, syminfo.mintick)
channelCompressionScore = contextAtr == 0 ? 0.0 : channelWidth / contextAtr
channelFreshLongBreakout = ta.barssince(close > channelUpper[1]) <= channelBreakoutFreshBars
channelFreshShortBreakout = ta.barssince(close < channelLower[1]) <= channelBreakoutFreshBars
channelLongRetestOk = not channelEnableRetest or ta.barssince(low <= channelUpper[1]) <= channelRetestFreshBars
channelShortRetestOk = not channelEnableRetest or ta.barssince(high >= channelLower[1]) <= channelRetestFreshBars
channelLongBoost = useChannelContext and channelCompressionScore <= channelCompressionThreshold and channelFreshLongBreakout and channelLongRetestOk
channelShortBoost = useChannelContext and channelCompressionScore <= channelCompressionThreshold and channelFreshShortBreakout and channelShortRetestOk
channelLongHostile = useChannelContext and channelHostileBlocksEntry and close < channelLower + channelWidth * 0.25
channelShortHostile = useChannelContext and channelHostileBlocksEntry and close > channelUpper - channelWidth * 0.25
contextLongQualify = not useContextAggregator ? true : (avwapLongOk and (not contextStrictRequireChannel or channelLongBoost or not useChannelContext))
contextShortQualify = not useContextAggregator ? true : (avwapShortOk and (not contextStrictRequireChannel or channelShortBoost or not useChannelContext))
contextLongBoost = not useContextAggregator ? 0.0 : (channelLongBoost ? contextBoostValue : 0.0)
contextShortBoost = not useContextAggregator ? 0.0 : (channelShortBoost ? contextBoostValue : 0.0)
contextLongBlocked = useContextAggregator and contextHostileBlocksEntry and channelLongHostile
contextShortBlocked = useContextAggregator and contextHostileBlocksEntry and channelShortHostile
contextLongCaution = useContextAggregator and (not contextLongQualify or contextLongBlocked)
contextShortCaution = useContextAggregator and (not contextShortQualify or contextShortBlocked)

var int lastEntryBar = na
cooldownOk = na(lastEntryBar) or (bar_index - lastEntryBar >= minBarsBetween)

startLongTrade = baseStartLong and (not useTrendXConf or trendx == 1) and (effectiveLongStrength >= minPredSum) and cooldownOk and longFusionPass and supertrendPassLong
startShortTrade = baseStartShort and (not useTrendXConf or trendx == -1) and (effectiveShortStrength >= minPredSum) and cooldownOk and shortFusionPass and supertrendPassShort

// Dynamic Exit Conditions: Booleans for ML Model Position Exits based on Fractal Filters and Kernel Regression Filters
lastSignalWasBullish = ta.barssince(startLongTrade) < ta.barssince(startShortTrade)
lastSignalWasBearish = ta.barssince(startShortTrade) < ta.barssince(startLongTrade)
barsSinceRedEntry = ta.barssince(startShortTrade)
barsSinceRedExit = ta.barssince(alertBullish)
barsSinceGreenEntry = ta.barssince(startLongTrade)
barsSinceGreenExit = ta.barssince(alertBearish)
isValidShortExit = barsSinceRedExit > barsSinceRedEntry
isValidLongExit = barsSinceGreenExit > barsSinceGreenEntry
endLongTradeDynamic = (isBearishChange and isValidLongExit[1])
endShortTradeDynamic = (isBullishChange and isValidShortExit[1])

// Fixed Exit Conditions: Booleans for ML Model Position Exits based on a Bar-Count Filters
endLongTradeStrict = ((isHeldFourBars and isLastSignalBuy) or (isHeldLessThanFourBars and isNewSellSignal and isLastSignalBuy)) and startLongTrade[4]
endShortTradeStrict = ((isHeldFourBars and isLastSignalSell) or (isHeldLessThanFourBars and isNewBuySignal and isLastSignalSell)) and startShortTrade[4]
isDynamicExitValid = not useEmaFilter and not useSmaFilter and not useKernelSmoothing
endLongTrade = settings.useDynamicExits and isDynamicExitValid ? endLongTradeDynamic : endLongTradeStrict 
endShortTrade = settings.useDynamicExits and isDynamicExitValid ? endShortTradeDynamic : endShortTradeStrict

// ===========================
// ==== Signal Engine      ====
// ===========================
// Removed strategy tester calls (strategy.entry/exit/close).
// Keep lightweight simulated position state for alerts and stop/target visualization.
enableStrategy = input.bool(true, title="Enable Signal Engine", group="Strategy")
useStopsTP     = input.bool(true,  title="Use ATR Stop/Target", group="Strategy")
riskAtrLen     = input.int(14,     title="ATR Length", minval=1, group="Strategy")
slAtrMult      = input.float(0.75,  title="SL ATR x", minval=0.1, step=0.1, group="Strategy")
tpAtrMult      = input.float(4.5,  title="TP ATR x (1:1 R:R by default)", minval=0.1, step=0.1, group="Strategy")
useSignalExits = input.bool(false, title="Use Signal-Based Exits (in addition to SL/TP)", group="Strategy")
useTrailingStop = input.bool(true, title="Use ATR Trailing Stop", group="Strategy")
trailAtrLen = input.int(14, title="Trail ATR Length", minval=1, group="Strategy")
trailAtrMult = input.float(1, title="Trail ATR x", minval=0.1, step=0.1, group="Strategy")
trailActivateR = input.float(0.5, title="Trail Activate at R", minval=0.0, step=0.25, group="Strategy")

var int simPos = 0
var float simEntryPrice = na
var float atrNow = na
var float trailAtrNow = na
var float simRiskDistance = na
var float simBaseStop = na
var float simTakeProfit = na
var float simTrailStop = na
var float activeStop = na
var float activeTakeProfit = na

atrNow := ta.atr(riskAtrLen)
trailAtrNow := ta.atr(trailAtrLen)

if enableStrategy
    if startLongTrade and simPos <= 0
        simPos := 1
        simEntryPrice := close
        simRiskDistance := slAtrMult * atrNow
        simBaseStop := useStopsTP ? close - simRiskDistance : na
        simTakeProfit := useStopsTP ? close + tpAtrMult * atrNow : na
        simTrailStop := na
        lastEntryBar := bar_index
    if startShortTrade and simPos >= 0
        simPos := -1
        simEntryPrice := close
        simRiskDistance := slAtrMult * atrNow
        simBaseStop := useStopsTP ? close + simRiskDistance : na
        simTakeProfit := useStopsTP ? close - tpAtrMult * atrNow : na
        simTrailStop := na
        lastEntryBar := bar_index

longTrailActive = useTrailingStop and simPos == 1 and not na(simRiskDistance) and close >= simEntryPrice + trailActivateR * simRiskDistance
shortTrailActive = useTrailingStop and simPos == -1 and not na(simRiskDistance) and close <= simEntryPrice - trailActivateR * simRiskDistance
longTrailCandidate = longTrailActive ? close - trailAtrMult * trailAtrNow : na
shortTrailCandidate = shortTrailActive ? close + trailAtrMult * trailAtrNow : na

if simPos == 1 and longTrailActive
    simTrailStop := na(simTrailStop) ? longTrailCandidate : math.max(simTrailStop, longTrailCandidate)
if simPos == -1 and shortTrailActive
    simTrailStop := na(simTrailStop) ? shortTrailCandidate : math.min(simTrailStop, shortTrailCandidate)

activeStop := simPos == 1 ? (na(simTrailStop) ? simBaseStop : math.max(simBaseStop, simTrailStop)) : simPos == -1 ? (na(simTrailStop) ? simBaseStop : math.min(simBaseStop, simTrailStop)) : na
activeTakeProfit := simPos != 0 ? simTakeProfit : na

longStopHit = useStopsTP and simPos == 1 and not na(activeStop) and (ta.crossunder(close, activeStop) or close <= activeStop)
longTakeHit = useStopsTP and simPos == 1 and not na(activeTakeProfit) and (ta.crossover(close, activeTakeProfit) or close >= activeTakeProfit)
shortStopHit = useStopsTP and simPos == -1 and not na(activeStop) and (ta.crossover(close, activeStop) or close >= activeStop)
shortTakeHit = useStopsTP and simPos == -1 and not na(activeTakeProfit) and (ta.crossunder(close, activeTakeProfit) or close <= activeTakeProfit)
longTrailExit = useTrailingStop and simPos == 1 and not na(simTrailStop) and longStopHit
shortTrailExit = useTrailingStop and simPos == -1 and not na(simTrailStop) and shortStopHit

if simPos == 1 and ((useSignalExits and endLongTrade) or longStopHit or longTakeHit)
    simPos := 0
    simEntryPrice := na
    simRiskDistance := na
    simBaseStop := na
    simTakeProfit := na
    simTrailStop := na
if simPos == -1 and ((useSignalExits and endShortTrade) or shortStopHit or shortTakeHit)
    simPos := 0
    simEntryPrice := na
    simRiskDistance := na
    simBaseStop := na
    simTakeProfit := na
    simTrailStop := na

// =========================
// ======== Alerts =========
// =========================
longEntryAlert  = enableStrategy and simPos == 1 and simPos[1] != 1
shortEntryAlert = enableStrategy and simPos == -1 and simPos[1] != -1
alertcondition(longEntryAlert,  title="Long Position Opened",  message="Long opened on {{ticker}} {{interval}} @ {{close}}")
alertcondition(shortEntryAlert, title="Short Position Opened", message="Short opened on {{ticker}} {{interval}} @ {{close}}")

longExitAlert  = enableStrategy and simPos == 0 and simPos[1] == 1 and endLongTrade
shortExitAlert = enableStrategy and simPos == 0 and simPos[1] == -1 and endShortTrade
alertcondition(longExitAlert,  title="Long Exit",  message="Long exit on {{ticker}} {{interval}} @ {{close}}")
alertcondition(shortExitAlert, title="Short Exit", message="Short exit on {{ticker}} {{interval}} @ {{close}}")

longStopAlert  = enableStrategy and longStopHit
shortStopAlert = enableStrategy and shortStopHit
alertcondition(longStopAlert,  title="Long Stop Hit",  message="Long stop hit on {{ticker}} {{interval}} @ {{close}}")
alertcondition(shortStopAlert, title="Short Stop Hit", message="Short stop hit on {{ticker}} {{interval}} @ {{close}}")

// =========================
// ==== Backtest-kit Outputs
// =========================
pineSignal = startLongTrade ? 1 : startShortTrade ? -1 : 0
pineStopLoss = simPos != 0 and not na(activeStop) ? activeStop : pineSignal == 1 ? close - slAtrMult * atrNow : pineSignal == -1 ? close + slAtrMult * atrNow : close
pineTakeProfit = simPos != 0 and not na(activeTakeProfit) ? activeTakeProfit : pineSignal == 1 ? close + tpAtrMult * atrNow : pineSignal == -1 ? close - tpAtrMult * atrNow : close
pineEstimatedTime = 240

// Optimizer-ready numeric exports
trendXLongPass = not useTrendXConf or trendx == 1
trendXShortPass = not useTrendXConf or trendx == -1
predLongStrengthPass = effectiveLongStrength >= minPredSum
predShortStrengthPass = effectiveShortStrength >= minPredSum

featurePrediction = prediction
featureTrendX = trendx
featureKernelEstimate = kernelEstimate
featureKernelBullish = isBullish ? 1 : 0
featureKernelBearish = isBearish ? 1 : 0
featureRawLongPrediction = prediction > 0 ? 1 : 0
featureRawShortPrediction = prediction < 0 ? 1 : 0
featureFilterVolatility = filter.volatility ? 1 : 0
featureFilterRegime = filter.regime ? 1 : 0
featureFilterAdx = filter.adx ? 1 : 0
featureFilterAll = filter_all ? 1 : 0
featureLongPostFilter = prediction > 0 and filter_all ? 1 : 0
featureShortPostFilter = prediction < 0 and filter_all ? 1 : 0
featureSignalLong = signal == direction.long ? 1 : 0
featureSignalShort = signal == direction.short ? 1 : 0
featureNewBuySignal = isNewBuySignal ? 1 : 0
featureNewSellSignal = isNewSellSignal ? 1 : 0
featureBaseStartLong = baseStartLong ? 1 : 0
featureBaseStartShort = baseStartShort ? 1 : 0
featureTrendXLongPass = trendXLongPass ? 1 : 0
featureTrendXShortPass = trendXShortPass ? 1 : 0
featurePredLongStrengthPass = predLongStrengthPass ? 1 : 0
featurePredShortStrengthPass = predShortStrengthPass ? 1 : 0
featureCooldownOk = cooldownOk ? 1 : 0
featureAtrFlipBull = fusionAtrFlipBull ? 1 : 0
featureAtrFlipBear = fusionAtrFlipBear ? 1 : 0
featureEmaCrossBull = fusionEmaCrossBull ? 1 : 0
featureEmaCrossBear = fusionEmaCrossBear ? 1 : 0
featureEngulfingBull = fusionEngulfingBull ? 1 : 0
featureEngulfingBear = fusionEngulfingBear ? 1 : 0
featureLongFusionScore = longFusionScore
featureShortFusionScore = shortFusionScore
featureLongFusionBonus = longFusionBonus
featureShortFusionBonus = shortFusionBonus
featureLongFusionPenalty = longFusionPenalty
featureShortFusionPenalty = shortFusionPenalty
featureLongFusionV4Residual = longFusionV4Residual
featureShortFusionV4Residual = shortFusionV4Residual
featureFusionV4Active = fusionV4RangeActive ? 1 : 0
featureEffectiveLongStrength = effectiveLongStrength
featureEffectiveShortStrength = effectiveShortStrength
featureLongFusionPass = longFusionPass ? 1 : 0
featureShortFusionPass = shortFusionPass ? 1 : 0
featureSupertrendBull = supertrendBull ? 1 : 0
featureSupertrendBear = supertrendBear ? 1 : 0
featureSupertrendPassLong = supertrendPassLong ? 1 : 0
featureSupertrendPassShort = supertrendPassShort ? 1 : 0
featureAvwapBullBias = avwapBullBias ? 1 : 0
featureAvwapBearBias = avwapBearBias ? 1 : 0
featureChannelCompressionScore = channelCompressionScore
featureContextLongQualify = contextLongQualify ? 1 : 0
featureContextShortQualify = contextShortQualify ? 1 : 0
featureLongContextCaution = contextLongCaution ? 1 : 0
featureShortContextCaution = contextShortCaution ? 1 : 0
featureBlockLongTrendX = baseStartLong and not trendXLongPass ? 1 : 0
featureBlockShortTrendX = baseStartShort and not trendXShortPass ? 1 : 0
featureBlockLongPred = baseStartLong and trendXLongPass and not predLongStrengthPass ? 1 : 0
featureBlockShortPred = baseStartShort and trendXShortPass and not predShortStrengthPass ? 1 : 0
featureBlockLongCooldown = baseStartLong and trendXLongPass and predLongStrengthPass and not cooldownOk ? 1 : 0
featureBlockShortCooldown = baseStartShort and trendXShortPass and predShortStrengthPass and not cooldownOk ? 1 : 0
featureBlockLongFusion = baseStartLong and trendXLongPass and predLongStrengthPass and cooldownOk and not longFusionPass ? 1 : 0
featureBlockShortFusion = baseStartShort and trendXShortPass and predShortStrengthPass and cooldownOk and not shortFusionPass ? 1 : 0
featureBlockLongSupertrend = baseStartLong and trendXLongPass and predLongStrengthPass and cooldownOk and longFusionPass and not supertrendPassLong ? 1 : 0
featureBlockShortSupertrend = baseStartShort and trendXShortPass and predShortStrengthPass and cooldownOk and shortFusionPass and not supertrendPassShort ? 1 : 0
featureStartLong = startLongTrade ? 1 : 0
featureStartShort = startShortTrade ? 1 : 0
featureEndLong = endLongTrade ? 1 : 0
featureEndShort = endShortTrade ? 1 : 0
featureTrailActive = ((longTrailActive and simPos == 1) or (shortTrailActive and simPos == -1)) ? 1 : 0
featureTrailStopDistance = simPos == 1 and not na(activeStop) ? close - activeStop : simPos == -1 and not na(activeStop) ? activeStop - close : 0
featureTrailMoved = not na(simTrailStop) ? 1 : 0
featureTrailExitLong = longTrailExit ? 1 : 0
featureTrailExitShort = shortTrailExit ? 1 : 0
featureSimPos = simPos

plot(close, "Close", display=display.data_window)
plot(pineSignal, "Signal", display=display.data_window)
plot(pineStopLoss, "StopLoss", display=display.data_window)
plot(pineTakeProfit, "TakeProfit", display=display.data_window)
plot(pineEstimatedTime, "EstimatedTime", display=display.data_window)
plot(featurePrediction, "Feature_Prediction", display=display.data_window)
plot(featureTrendX, "Feature_TrendX", display=display.data_window)
plot(featureKernelEstimate, "Feature_KernelEstimate", display=display.data_window)
plot(featureKernelBullish, "Feature_KernelBullish", display=display.data_window)
plot(featureKernelBearish, "Feature_KernelBearish", display=display.data_window)
plot(featureRawLongPrediction, "Feature_RawLongPrediction", display=display.data_window)
plot(featureRawShortPrediction, "Feature_RawShortPrediction", display=display.data_window)
plot(featureFilterVolatility, "Feature_FilterVolatility", display=display.data_window)
plot(featureFilterRegime, "Feature_FilterRegime", display=display.data_window)
plot(featureFilterAdx, "Feature_FilterAdx", display=display.data_window)
plot(featureFilterAll, "Feature_FilterAll", display=display.data_window)
plot(featureLongPostFilter, "Feature_LongPostFilter", display=display.data_window)
plot(featureShortPostFilter, "Feature_ShortPostFilter", display=display.data_window)
plot(featureSignalLong, "Feature_SignalLong", display=display.data_window)
plot(featureSignalShort, "Feature_SignalShort", display=display.data_window)
plot(featureNewBuySignal, "Feature_NewBuySignal", display=display.data_window)
plot(featureNewSellSignal, "Feature_NewSellSignal", display=display.data_window)
plot(featureBaseStartLong, "Feature_BaseStartLong", display=display.data_window)
plot(featureBaseStartShort, "Feature_BaseStartShort", display=display.data_window)
plot(featureTrendXLongPass, "Feature_TrendXLongPass", display=display.data_window)
plot(featureTrendXShortPass, "Feature_TrendXShortPass", display=display.data_window)
plot(featurePredLongStrengthPass, "Feature_PredLongStrengthPass", display=display.data_window)
plot(featurePredShortStrengthPass, "Feature_PredShortStrengthPass", display=display.data_window)
plot(featureCooldownOk, "Feature_CooldownOk", display=display.data_window)
plot(featureAtrFlipBull, "Feature_AtrFlipBull", display=display.data_window)
plot(featureAtrFlipBear, "Feature_AtrFlipBear", display=display.data_window)
plot(featureEmaCrossBull, "Feature_EmaCrossBull", display=display.data_window)
plot(featureEmaCrossBear, "Feature_EmaCrossBear", display=display.data_window)
plot(featureEngulfingBull, "Feature_EngulfingBull", display=display.data_window)
plot(featureEngulfingBear, "Feature_EngulfingBear", display=display.data_window)
plot(featureLongFusionScore, "Feature_LongFusionScore", display=display.data_window)
plot(featureShortFusionScore, "Feature_ShortFusionScore", display=display.data_window)
plot(featureLongFusionBonus, "Feature_LongFusionBonus", display=display.data_window)
plot(featureShortFusionBonus, "Feature_ShortFusionBonus", display=display.data_window)
plot(featureLongFusionPenalty, "Feature_LongFusionPenalty", display=display.data_window)
plot(featureShortFusionPenalty, "Feature_ShortFusionPenalty", display=display.data_window)
plot(featureLongFusionV4Residual, "Feature_LongFusionV4Residual", display=display.data_window)
plot(featureShortFusionV4Residual, "Feature_ShortFusionV4Residual", display=display.data_window)
plot(featureFusionV4Active, "Feature_FusionV4Active", display=display.data_window)
plot(featureEffectiveLongStrength, "Feature_EffectiveLongStrength", display=display.data_window)
plot(featureEffectiveShortStrength, "Feature_EffectiveShortStrength", display=display.data_window)
plot(featureLongFusionPass, "Feature_LongFusionPass", display=display.data_window)
plot(featureShortFusionPass, "Feature_ShortFusionPass", display=display.data_window)
plot(featureSupertrendBull, "Feature_SupertrendBull", display=display.data_window)
plot(featureSupertrendBear, "Feature_SupertrendBear", display=display.data_window)
plot(featureSupertrendPassLong, "Feature_SupertrendPassLong", display=display.data_window)
plot(featureSupertrendPassShort, "Feature_SupertrendPassShort", display=display.data_window)
plot(featureAvwapBullBias, "Feature_AvwapBullBias", display=display.data_window)
plot(featureAvwapBearBias, "Feature_AvwapBearBias", display=display.data_window)
plot(featureChannelCompressionScore, "Feature_ChannelCompressionScore", display=display.data_window)
plot(featureContextLongQualify, "Feature_ContextLongQualify", display=display.data_window)
plot(featureContextShortQualify, "Feature_ContextShortQualify", display=display.data_window)
plot(featureLongContextCaution, "Feature_LongContextCaution", display=display.data_window)
plot(featureShortContextCaution, "Feature_ShortContextCaution", display=display.data_window)
plot(featureBlockLongTrendX, "Feature_BlockLong_TrendX", display=display.data_window)
plot(featureBlockShortTrendX, "Feature_BlockShort_TrendX", display=display.data_window)
plot(featureBlockLongPred, "Feature_BlockLong_Pred", display=display.data_window)
plot(featureBlockShortPred, "Feature_BlockShort_Pred", display=display.data_window)
plot(featureBlockLongCooldown, "Feature_BlockLong_Cooldown", display=display.data_window)
